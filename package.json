{
	"name": "ai-affiliate-factory",
	"private": true,
	"description": "AI-Native Semantic Publishing Operating System",
	"version": "2026.1.0",
	"type": "module",
	"packageManager": "pnpm@10.8.0",
	"engines": {
		"node": "^22.0.0",
		"pnpm": "^10.0.0"
	},
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write . && prettier --write \"**/*.astro\"",
		"format:check": "biome format . && prettier --check \"**/*.astro\"",
		"typecheck": "turbo typecheck",
		"clean": "turbo clean",
		"apps:dev": "turbo dev --filter=@af/brand-x-us",
		"apps:build": "turbo build --filter=@af/brand-x-us"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"autoprefixer": "^10.5.0",
		"cssnano": "^8.0.1",
		"postcss": "^8.5.15",
		"prettier": "^3.5.0",
		"prettier-plugin-astro": "^0.14.0",
		"turbo": "^2.5.0",
		"typescript": "^5.8.0"
	}
}
