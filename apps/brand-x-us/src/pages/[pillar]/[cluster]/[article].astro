---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { ArticleLayout } from '@af/layouts';
import type { BreadcrumbItem } from '@af/ui';

type ArticleEntry = CollectionEntry<'articles'>;

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((entry: ArticleEntry) => ({
    params: {
      pillar: entry.data.pillarId,
      cluster: slugify(entry.data.cluster),
      article: entry.id,
    },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: ArticleEntry };

function slugify(text: string): string {
  return text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}

const breadcrumb: BreadcrumbItem[] = [
  { label: 'Home', href: '/' },
  { label: entry.data.cluster, href: `/${entry.data.pillarId}` },
  { label: entry.data.title, href: '' },
];

const authorData = entry.data.author
  ? {
      name: entry.data.author,
      role: entry.data.authorRole || undefined,
      bio: entry.data.authorBio || undefined,
    }
  : undefined;

const { Content } = await render(entry);
---

<ArticleLayout
  article={{
    title: entry.data.title,
    description: entry.data.description,
    image: entry.data.image,
    publishedAt: entry.data.publishedAt.toISOString(),
    updatedAt: entry.data.updatedAt?.toISOString(),
    readTime: entry.data.readTime,
    category: entry.data.category || entry.data.cluster,
    tags: entry.data.tags,
    author: authorData,
    breadcrumb,
  }}
>
  <Content />
</ArticleLayout>
