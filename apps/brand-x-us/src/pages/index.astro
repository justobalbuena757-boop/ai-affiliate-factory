---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Evergreen Vitality Labs — Science-Backed Wellness for Life"
  description="Evidence-based metabolic health, weight wellness, and daily energy optimization for adults 40+."
>
  <section aria-labelledby="hero-title">
    <h1 id="hero-title">Thrive at Every Stage</h1>
    <p>Science-backed metabolic wellness for your best years ahead.</p>
  </section>

  <section aria-labelledby="pillars-title">
    <h2 id="pillars-title">Our Wellness Pillars</h2>
    <div>
      <article>
        <h3>Metabolic Wellness</h3>
        <p>Support your metabolism with evidence-based strategies.</p>
      </article>
      <article>
        <h3>Daily Energy Optimization</h3>
        <p>Sustainable energy throughout your day, naturally.</p>
      </article>
      <article>
        <h3>Sustainable Healthy Habits</h3>
        <p>Build routines that last a lifetime.</p>
      </article>
    </div>
  </section>

  <section aria-labelledby="quiz-cta">
    <h2 id="quiz-cta">Discover Your Metabolic Score</h2>
    <p>Take our 2-minute quiz and get personalized insights.</p>
  </section>
</Layout>
