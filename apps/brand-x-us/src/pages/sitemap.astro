---
const baseUrl = 'https://evergreenvitalitylabs.com';
const staticPages = [
  { loc: '/', priority: '1.0' },
];
---

<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {staticPages.map((page) => (
    <url>
      <loc>{baseUrl}{page.loc}</loc>
      <priority>{page.priority}</priority>
    </url>
  ))}
</urlset>
