---
import Layout from '@af/layouts/Layout.astro';
import type { LayoutProps } from '@af/layouts';

interface Props extends LayoutProps {}

const { title, description, canonical, image, jsonLd, lang } = Astro.props as Props;
---

<Layout
  title={title}
  description={description}
  {canonical}
  {image}
  {jsonLd}
  {lang}
  headerLogoText="Evergreen Vitality Labs"
  headerLogoHref="/"
>
  <slot />
</Layout>
