---
import Layout from '@af/layouts/Layout.astro';
import type { LayoutProps } from '@af/layouts';

type Props = LayoutProps;

const { title, description, canonical, image } = Astro.props as Props;
---

<Layout
  title={title}
  description={description}
  {canonical}
  {image}
  headerLogoText="Evergreen Vitality Labs"
  headerLogoHref="/"
>
  <slot />
</Layout>
