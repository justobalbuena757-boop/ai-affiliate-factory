---
import { getCollection } from 'astro:content';
import PillarLayout from '../../layouts/PillarLayout.astro';

export async function getStaticPaths() {
  const pillars = await getCollection('pillars');
  return pillars.map((entry) => ({
    params: { pillar: entry.id.replace(/\.mdx$/, '') },
    props: { pillar: entry },
  }));
}

const { pillar } = Astro.params;
const { pillar: pillarData } = Astro.props;

const articles = await getCollection('articles', ({ data }: { data: { pillar: string } }) =>
  data.pillar === pillar,
);

if (!pillarData) {
  return Astro.redirect('/404');
}
---

<PillarLayout pillar={pillarData} articles={articles} />
