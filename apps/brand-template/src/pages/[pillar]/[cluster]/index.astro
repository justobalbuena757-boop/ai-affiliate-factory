---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { Container, Card, Breadcrumb } from 'design-system-base';
import type { CollectionEntry } from 'astro:content';
import tenant from '../../../config/tenant.json';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  const clusters = new Set<string>();
  articles.forEach(a => clusters.add(`${a.data.pillar}/${a.data.cluster}`));
  return Array.from(clusters).map(pair => {
    const [pillar, cluster] = pair.split('/');
    return { params: { pillar, cluster } };
  });
}

const { pillar, cluster } = Astro.params;

const articles = await getCollection('articles', ({ data }) =>
  data.pillar === pillar && data.cluster === cluster,
);

const pillarEntry = await getCollection('pillars');
const pillarData = pillarEntry.find(p => p.id.replace('.mdx', '') === pillar);

const stageColors: Record<string, string> = {
  tofu: 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400',
  mofu: 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400',
  bofu: 'bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-blue-400',
};

const stageLabels: Record<string, string> = { tofu: 'TOFU', mofu: 'MOFU', bofu: 'BOFU' };
const stageOrder = ['tofu', 'mofu', 'bofu'];

const sorted = articles.sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title={`${cluster.replace(/-/g, ' ')} — ${pillarData?.data.title || pillar.replace(/-/g, ' ')} | ${tenant.brand.name}`}
  description={`Explore articles in the ${cluster.replace(/-/g, ' ')} cluster`}
  type="website"
>
  <div class="bg-gray-50 dark:bg-gray-800/30 border-b border-gray-200 dark:border-gray-800">
    <Container class="py-4">
      <Breadcrumb
        items={[
          { label: pillar.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()), href: `/${pillar}` },
          { label: cluster.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()) },
        ]}
      />
    </Container>
  </div>

  <section class="py-16 sm:py-20">
    <Container>
      <header class="mb-12 text-center">
        <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4 capitalize">
          {cluster.replace(/-/g, ' ')}
        </h1>
        <p class="text-lg text-gray-500 dark:text-gray-400 max-w-2xl mx-auto">
          {articles.length} article{articles.length !== 1 ? 's' : ''} in this cluster
        </p>
      </header>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 max-w-5xl mx-auto">
        {stageOrder.map(stage => {
          const stageArticles = sorted.filter(a => a.data.stage === stage);
          if (stageArticles.length === 0) return null;
          
          return (
            <section class="sm:col-span-2 lg:col-span-3 mb-12 last:mb-0">
              <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-3">
                <span class={stageColors[stage] ? stageColors[stage] : 'bg-gray-100 text-gray-700 dark:bg-gray-800'}>
                  {stageLabels[stage] || stage}
                </span>
                <span class="text-sm text-gray-400">({stageArticles.length} article{stageArticles.length !== 1 ? 's' : ''})</span>
              </h2>
              <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {stageArticles.map(a => {
                  const articleSlug = a.id.replace('.mdx', '').split('/').pop();
                  return (
                    <a
                      href={`/${a.data.pillar}/${a.data.cluster}/${articleSlug}`}
                      class="block group"
                    >
                      <Card variant="interactive" class="h-full">
                        <div class="flex flex-col h-full">
                          <h3 class="text-base font-semibold text-gray-900 dark:text-white group-hover:text-primary transition-colors leading-snug">
                            {a.data.title}
                          </h3>
                          <p class="mt-2 text-sm text-gray-500 dark:text-gray-400 line-clamp-2 flex-1">
                            {a.data.description}
                          </p>
                          <time class="mt-4 text-xs text-gray-400">
                            {new Date(a.data.pubDate).toLocaleDateString('en-US', {
                              year: 'numeric', month: 'long', day: 'numeric',
                            })}
                          </time>
                        </div>
                      </Card>
                    </a>
                  );
                })}
              </div>
            </section>
          );
        })}
      </div>
    </Container>
  </section>
</Layout>