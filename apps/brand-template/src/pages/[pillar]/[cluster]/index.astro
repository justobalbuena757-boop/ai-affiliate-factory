---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import { Container, Card, Breadcrumb } from "design-system-base";
import { STAGE_COLORS, STAGE_LABELS_SHORT } from "../../../lib/stage";
import type { CollectionEntry } from "astro:content";
import tenant from "../../../config/tenant.json";

export async function getStaticPaths() {
	const articles = await getCollection("articles");
	const clusters = new Set<string>();
	articles.forEach((a) => clusters.add(`${a.data.pillar}/${a.data.cluster}`));
	return Array.from(clusters).map((pair) => {
		const [pillar, cluster] = pair.split("/");
		return { params: { pillar, cluster } };
	});
}

const { pillar, cluster } = Astro.params;

const articles = await getCollection(
	"articles",
	({ data }) => data.pillar === pillar && data.cluster === cluster,
);

const pillarEntry = await getCollection("pillars");
const pillarData = pillarEntry.find((p) => p.id.replace(".mdx", "") === pillar);
const pillarTitle =
	pillarData?.data?.title ||
	pillar.replace(/-/g, " ").replace(/\b\w/g, (c: string) => c.toUpperCase());
const clusterTitle = cluster
	.replace(/-/g, " ")
	.replace(/\b\w/g, (c: string) => c.toUpperCase());

const stageOrder = ["tofu", "mofu", "bofu"];

const sorted = articles.sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title={`${clusterTitle} — ${pillarTitle} | ${tenant.brand.name}`}
  description={`Explore articles in the ${clusterTitle} cluster`}
  type="website"
>
  <div class="bg-muted/5 dark:bg-surface-dark/30 border-b border-border dark:border-border-dark">
    <Container class="py-4">
      <Breadcrumb
        items={[
          { label: pillarTitle, href: `/${pillar}` },
          { label: clusterTitle },
        ]}
      />
    </Container>
  </div>

  <section class="py-16 sm:py-20">
    <Container>
      <header class="mb-12 text-center">
        <h1 class="text-3xl sm:text-4xl font-bold text-foreground dark:text-foreground-dark mb-4 capitalize">
          {clusterTitle}
        </h1>
        <p class="text-lg text-muted dark:text-muted-dark max-w-2xl mx-auto">
          {articles.length} article{articles.length !== 1 ? 's' : ''} in this cluster
        </p>
      </header>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 max-w-5xl mx-auto">
        {stageOrder.map(stage => {
          const stageArticles = sorted.filter(a => a.data.stage === stage);
          if (stageArticles.length === 0) return null;
          
          return (
            <section class="sm:col-span-2 lg:col-span-3 mb-12 last:mb-0">
              <h2 class="text-xl font-bold text-foreground dark:text-foreground-dark mb-6 flex items-center gap-3">
                <span class={STAGE_COLORS[stage] || 'bg-muted/10 text-muted dark:bg-surface-dark'}>
                  {STAGE_LABELS_SHORT[stage] || stage}
                </span>
                <span class="text-sm text-muted dark:text-muted-dark">({stageArticles.length} article{stageArticles.length !== 1 ? 's' : ''})</span>
              </h2>
              <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {stageArticles.map(a => {
                  const articleSlug = a.id.replace('.mdx', '').split('/').pop();
                  return (
                    <a
                      href={`/${a.data.pillar}/${a.data.cluster}/${articleSlug}`}
                      class="block group"
                    >
                      <Card variant="interactive" class="h-full">
                        {a.data.ogImage && (
                          <div class="relative overflow-hidden aspect-video -mx-6 -mt-6 mb-4 rounded-t-xl">
                            <img
                              src={a.data.ogImage}
                              alt={a.data.title}
                              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                              loading="lazy"
                            />
                          </div>
                        )}
                        <div class="flex flex-col h-full">
                          <h3 class="text-base font-semibold text-foreground dark:text-foreground-dark group-hover:text-primary transition-colors leading-snug">
                            {a.data.title}
                          </h3>
                          <p class="mt-2 text-sm text-muted dark:text-muted-dark line-clamp-2 flex-1">
                            {a.data.description}
                          </p>
                          <time class="mt-4 text-xs text-muted dark:text-muted-dark">
                            {new Date(a.data.pubDate).toLocaleDateString('en-US', {
                              year: 'numeric', month: 'long', day: 'numeric',
                            })}
                          </time>
                        </div>
                      </Card>
                    </a>
                  );
                })}
              </div>
            </section>
          );
        })}
      </div>
    </Container>
  </section>
</Layout>
