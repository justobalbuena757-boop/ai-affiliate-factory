---
import { getCollection, getEntry, render } from "astro:content";
import ArticleLayout from "../../../layouts/ArticleLayout.astro";
import * as mdxComponents from "../../../components/mdx/index.js";

export async function getStaticPaths() {
	const articles = await getCollection("articles");
	return articles.map((entry) => {
		const id = entry.id.replace(/\.mdx$/, "");
		const segments = id.split("/");
		return {
			params: {
				pillar: segments[0],
				cluster: segments[1],
				article: segments.slice(2).join("/"),
			},
			props: { entryId: entry.id },
		};
	});
}

const { pillar, cluster, article } = Astro.params;
const { entryId } = Astro.props;

const entry = await getEntry("articles", entryId);

if (!entry) {
	return Astro.redirect("/404");
}

const allArticles = await getCollection("articles");
const relatedArticles = allArticles.filter(
	(a: (typeof allArticles)[number]) =>
		a.data.pillar === entry.data.pillar && a.id !== entry.id,
);

const pillars = await getCollection("pillars");
const pillarEntry = pillars.find((p) => p.id.replace(".mdx", "") === pillar);

const { Content, headings } = await render(entry);
---

<ArticleLayout article={entry} headings={headings} relatedArticles={relatedArticles} pillarEntry={pillarEntry}>
  <Content components={mdxComponents} />
</ArticleLayout>
