---
import Layout from '../layouts/Layout.astro';
import { Container } from 'design-system-base';
---

<Layout
  title="Editorial Policy — Metabolic 40+"
  description="Our editorial standards and transparency policies for content creation and reviews."
  type="website"
>
  <Container class="py-16 sm:py-20 max-w-3xl">
    <article class="prose dark:prose-invert max-w-none">
      <header class="mb-12">
        <h1 class="text-4xl font-bold text-gray-900 dark:text-white">Editorial Policy</h1>
        <p class="mt-4 text-gray-500 dark:text-gray-400">
          Last updated: June 2026
        </p>
      </header>

      <div class="space-y-8">
        <section>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Our Commitment</h2>
          <p class="text-gray-600 dark:text-gray-400">
            At Metabolic 40+, we are committed to providing accurate, evidence-based information about metabolic health for adults over 40. 
            Our editorial team consists of health writers, nutritionists, and wellness researchers who prioritize your health and safety.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Source Standards</h2>
          <p class="text-gray-600 dark:text-gray-400">
            All articles are based on peer-reviewed research, scientific literature, or interviews with qualified healthcare professionals. 
            We clearly cite our sources and provide links to original studies whenever possible.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Review Process</h2>
          <p class="text-gray-600 dark:text-gray-400">
            Our content undergoes a rigorous review process including:
          </p>
          <ul class="mt-4 list-disc list-inside text-gray-600 dark:text-gray-400 space-y-2">
            <li>Medical review by qualified professionals</li>
            <li>Fact-checking against peer-reviewed sources</li>
            <li>Regular content updates to reflect current research</li>
          </ul>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Affiliate Relationships</h2>
          <p class="text-gray-600 dark:text-gray-400">
            We participate in affiliate programs including Amazon Associates. This means we may earn a commission 
            when you purchase through our links, at no additional cost to you. We only recommend products we 
            believe in and have personally evaluated or thoroughly researched.
          </p>
        </section>
      </div>
    </article>
  </Container>
</Layout>