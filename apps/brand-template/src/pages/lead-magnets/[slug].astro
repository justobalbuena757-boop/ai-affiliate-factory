---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Container } from 'design-system-base';

export async function getStaticPaths() {
  const leadMagnets = await getCollection('leadMagnets');
  return leadMagnets.map(entry => ({
    params: { slug: entry.id.replace('.mdx', '') },
    props: { entry },
  }));
}

const { slug } = Astro.params;
const { entry } = Astro.props;

if (!entry) {
  return Astro.redirect('/404');
}
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  type="website"
>
  <Container class="py-16 sm:py-20 max-w-2xl">
    <article class="bg-white dark:bg-gray-900 rounded-xl shadow-lg p-8 sm:p-12">
      <header class="mb-8">
        <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">
          {entry.data.title}
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-400">
          {entry.data.description}
        </p>
      </header>

      {entry.data.emailRequired && (
        <form action="/api/subscribe" method="POST" class="bg-gray-50 dark:bg-gray-800/50 p-6 rounded-lg">
          <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4">
            Get Instant Access
          </h3>
          <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
            Enter your email to download this free guide.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <input
              type="email"
              name="email"
              placeholder="your@email.com"
              required
              class="flex-1 px-4 py-3 rounded-lg border dark:bg-gray-700 dark:border-gray-600 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary"
            />
            <button
              type="submit"
              class="bg-primary text-white px-6 py-3 rounded-lg font-medium hover:bg-primary-dark transition-colors"
            >
              Download
            </button>
          </div>
        </form>
      )}

      {!entry.data.emailRequired && (
        <a
          href={entry.data.downloadUrl}
          class="inline-block bg-primary text-white px-8 py-4 rounded-lg font-medium hover:bg-primary-dark transition-colors text-center"
        >
          Download Guide
        </a>
      )}
    </article>
  </Container>
</Layout>