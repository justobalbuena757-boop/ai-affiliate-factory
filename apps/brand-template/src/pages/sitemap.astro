---
import Layout from "../layouts/Layout.astro";
import { Container } from "design-system-base";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

type Pillar = CollectionEntry<"pillars">;
type Article = CollectionEntry<"articles">;

const pillars = await getCollection("pillars");
const articles = await getCollection("articles");

const staticPages = [
	{
		href: "/",
		label: "Home",
		description: "Welcome and overview of all content pillars",
	},
	{
		href: "/about/",
		label: "About",
		description: "Editorial team, mission, and standards",
	},
	{
		href: "/disclosure/",
		label: "Affiliate Disclosure",
		description: "Our affiliate disclosure policy",
	},
	{
		href: "/sitemap/",
		label: "Sitemap",
		description: "Complete HTML sitemap of all pages",
	},
];

const articlesByPillar = pillars.map((p: Pillar) => {
	const pillarSlug = p.id.replace(".mdx", "");
	return {
		pillar: p,
		articles: articles
			.filter((a: Article) => a.data.pillar === pillarSlug)
			.sort((a: Article, b: Article) => a.data.order - b.data.order),
	};
});

const totalArticles = articles.length;
const totalPages = staticPages.length + pillars.length + totalArticles;
const siteUrl = Astro.site?.toString() || "https://metabolic40plus.com";
const normalizedSiteUrl = siteUrl.replace(/\/$/, "");
---

<Layout
  title="Sitemap — All Pages & Articles"
  description="Complete HTML sitemap of Metabolic 40+. Browse all content pillars, articles, and static pages in one place."
  type="website"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Sitemap',
    description: 'Complete sitemap of all pages and articles on Metabolic 40+.',
    url: `${normalizedSiteUrl}/sitemap/`,
  }}
>
  <Container class="py-12 sm:py-16">
    <header class="max-w-3xl mx-auto mb-12 text-center">
      <p class="text-sm font-semibold text-primary uppercase tracking-wider mb-3">Navigation</p>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-gray-900 dark:text-white mb-4">
        Sitemap
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-400">
        {totalPages} pages and {totalArticles} articles across {pillars.length} content pillars.
      </p>
    </header>

    <div class="max-w-4xl mx-auto space-y-12">
      <section>
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 pb-2 border-b border-gray-200 dark:border-gray-700">
          Main Pages
        </h2>
        <ul class="grid gap-3 sm:grid-cols-2">
          {staticPages.map(page => (
            <li>
              <a
                href={page.href}
                class="block p-4 rounded-lg bg-gray-50 dark:bg-gray-800/50 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors group"
              >
                <span class="block font-semibold text-gray-900 dark:text-white group-hover:text-primary transition-colors">
                  {page.label}
                </span>
                <span class="block mt-1 text-sm text-gray-500 dark:text-gray-400">
                  {page.description}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      {articlesByPillar.map(({ pillar, articles: pillarArticles }) => (
        <section>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2 flex items-center gap-3">
            {pillar.data.icon && <span class="text-2xl">{pillar.data.icon}</span>}
            {pillar.data.title}
            <span class="text-sm font-normal text-gray-500 dark:text-gray-400">
              ({pillarArticles.length} {pillarArticles.length === 1 ? 'article' : 'articles'})
            </span>
          </h2>
          <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">
            {pillar.data.description}
          </p>
          <a
            href={`/${pillar.id.replace('.mdx', '')}/`}
            class="inline-block text-sm font-semibold text-primary hover:underline mb-4"
          >
            View pillar →
          </a>
          <ul class="space-y-2">
            {pillarArticles.map(article => {
              const articleSlug = article.id.replace('.mdx', '').split('/').pop();
              const articleUrl = `/${article.data.pillar}/${article.data.cluster}/${articleSlug}`;
              return (
                <li>
                  <a
                    href={articleUrl}
                    class="flex items-start gap-3 p-3 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors group"
                  >
                    <span class="flex-1 min-w-0">
                      <span class="block font-medium text-gray-900 dark:text-white group-hover:text-primary transition-colors">
                        {article.data.title}
                      </span>
                      <span class="block mt-0.5 text-sm text-gray-500 dark:text-gray-400 line-clamp-1">
                        {article.data.description}
                      </span>
                    </span>
                    <span class="text-xs text-gray-400 dark:text-gray-500 uppercase font-semibold tracking-wider shrink-0 mt-0.5">
                      {article.data.stage}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
  </Container>
</Layout>