---
import Layout from "../layouts/Layout.astro";
import { Container } from "design-system-base";
---

<Layout
  title="Affiliate Disclosure — Metabolic 40+"
  description="Our affiliate relationships and how we earn revenue from product recommendations."
  type="website"
>
  <Container class="py-16 sm:py-20 max-w-3xl">
    <article class="prose dark:prose-invert max-w-none">
      <header class="mb-12">
        <h1 class="text-4xl font-bold text-gray-900 dark:text-white">Affiliate Disclosure</h1>
        <p class="mt-4 text-gray-500 dark:text-gray-400">How we fund our content creation</p>
      </header>

      <div class="space-y-8">
        <section>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Our Model</h2>
          <p class="text-gray-600 dark:text-gray-400">
            Metabolic 40+ is a participant in affiliate advertising programs designed to provide 
            a means for sites to earn advertising fees by linking to products. When you click 
            links on our site and make purchases, we may earn a commission at no extra cost to you.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Products We Recommend</h2>
          <p class="text-gray-600 dark:text-gray-400">
            We only recommend products that we believe will provide value to our readers. 
            This includes:
          </p>
          <ul class="mt-4 list-disc list-inside text-gray-600 dark:text-gray-400 space-y-2">
            <li>Products we have personally researched or used</li>
            <li>Items recommended by healthcare professionals we trust</li>
            <li>Supplements with verifiable ingredient lists and third-party testing</li>
          </ul>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Current Partnerships</h2>
          <p class="text-gray-600 dark:text-gray-400">
            We currently participate in affiliate programs with product manufacturers and retailers 
            including Java Burn and other metabolic health brands. Affiliate links are clearly 
            marked where applicable.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Your Trust</h2>
          <p class="text-gray-600 dark:text-gray-400">
            Our editorial integrity is more important than any commission we might earn. 
            We never let advertising relationships influence our product recommendations or 
            the content of our articles.
          </p>
        </section>
      </div>
    </article>
  </Container>
</Layout>