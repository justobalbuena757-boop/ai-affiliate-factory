---
import Layout from "../layouts/Layout.astro";
import {
	Container,
	Card,
	Button,
	Hero,
	Badge,
	CTASection,
	FeaturesGrid,
} from "design-system-base";
import NewsletterBox from "../components/NewsletterBox.astro";
import tenant from "../config/tenant.json";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const brand = tenant.brand;
const pillars = await getCollection("pillars");
const allArticles = await getCollection("articles");
const published = allArticles
	.filter((p: CollectionEntry<"articles">) => !p.data.draft)
	.sort(
		(a: CollectionEntry<"articles">, b: CollectionEntry<"articles">) =>
			b.data.pubDate - a.data.pubDate,
	);

const featuredArticles = published.slice(0, 3);
const editorsPicks = published
	.filter((a: CollectionEntry<"articles">) => a.data.stage === "bofu")
	.slice(0, 2);

const trustStats = [
	{ value: "10K+", label: "Monthly Readers" },
	{ value: "50+", label: "Research Articles" },
	{ value: "100+", label: "Clinical Studies" },
	{ value: "4.8★", label: "Reader Rating" },
];

import { iconSvg } from "../lib/icons";

const researchBadges = [
	{ label: "Expert Reviewed", icon: "✓" },
	{ label: "Evidence‑Based", icon: "✓" },
	{ label: "Updated Weekly", icon: "✓" },
	{ label: "Transparent AI", icon: "✓" },
];

const pillarFeatures = pillars.map((p: CollectionEntry<"pillars">) => ({
	icon: p.id === "coffee-wellness" ? iconSvg.coffee : iconSvg.bed,
	title: p.data.title,
	description: p.data.description,
	href: `/${p.id}`,
}));
---

<Layout
  title={`${brand.name} | ${brand.tagline}`}
  description={brand.description}
  image={brand.defaultOgImage}
  type="website"
  heroImage={brand.defaultOgImage}
>
  <Hero
    title="Evidence-Based Wellness Intelligence for Adults 40+"
    subtitle="Expertly curated insights on metabolism, coffee, sleep, hormones, and healthy aging — backed by peer-reviewed research and reviewed by our editorial team."
    primaryCta={{ label: 'Explore Research', href: '/coffee-wellness' }}
    secondaryCta={{ label: 'Take the Quiz', href: '/quiz/metabolism-quiz' }}
    variant="gradient"
    backgroundImage={brand.defaultOgImage}
  />

  <section class="py-8 sm:py-10 border-b border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-900/30">
    <Container>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8">
        {trustStats.map((stat) => (
          <div class="text-center">
            <div class="text-2xl sm:text-3xl lg:text-4xl font-bold text-primary">
              {stat.value}
            </div>
            <div class="mt-1 text-xs sm:text-sm text-gray-500 dark:text-gray-400 font-medium uppercase tracking-wider">
              {stat.label}
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <section class="py-4 border-b border-gray-200 dark:border-gray-800">
    <Container>
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-2 text-xs sm:text-sm text-gray-500 dark:text-gray-400">
        {researchBadges.map((badge) => (
          <span class="inline-flex items-center gap-1.5">
            <span class="w-3.5 h-3.5 text-green-500 shrink-0" set:html={iconSvg.check} />
            {badge.label}
          </span>
        ))}
      </div>
    </Container>
  </section>

  {pillarFeatures.length > 0 && (
    <FeaturesGrid
      title="Explore Research Topics"
      subtitle="Deep-dive into evidence-based wellness topics curated for healthy aging after 40."
      features={pillarFeatures}
      columns={{ base: 1, md: 2, lg: 3 }}
    />
  )}

  {editorsPicks.length > 0 && (
    <section class="py-16 sm:py-20 bg-gray-50 dark:bg-gray-800/20">
      <Container>
        <header class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">
            Editor's Picks
          </h2>
          <p class="text-lg text-gray-500 dark:text-gray-400 max-w-2xl mx-auto">
            Our team's top-rated research and analysis for metabolic health after 40.
          </p>
        </header>
        <div class="grid md:grid-cols-2 gap-6 lg:gap-8 max-w-4xl mx-auto">
          {editorsPicks.map((article: any) => (
              <a href={`/${article.data.pillar}/${article.data.cluster}/${article.id.replace('.mdx', '').split('/').pop()}`} class="block group focus:outline-none focus:ring-2 focus:ring-primary rounded-xl">
                <Card variant="interactive" class="h-full">
                  <div class="flex flex-col h-full">
                    <Badge variant={article.data.stage === 'bofu' ? 'accent' : 'default'} size="sm">
                      {article.data.stage === 'bofu' ? 'Editor\'s Choice' : 'Featured'}
                    </Badge>
                    <h3 class="mt-3 text-lg font-semibold text-gray-900 dark:text-white group-hover:text-primary transition-colors leading-snug">
                      {article.data.title}
                    </h3>
                    <p class="mt-2 text-sm text-gray-500 dark:text-gray-400 line-clamp-3 flex-1">
                      {article.data.description}
                    </p>
                    <div class="mt-4 flex items-center gap-3 text-xs text-gray-400">
                      <time>
                        {new Date(article.data.pubDate).toLocaleDateString('en-US', {
                          month: 'short', day: 'numeric', year: 'numeric',
                        })}
                      </time>
                      <span class="font-medium text-primary group-hover:text-primary-dark transition-colors">
                        Read Analysis →
                      </span>
                    </div>
                  </div>
                </Card>
              </a>
          ))}
        </div>
      </Container>
    </section>
  )}

  {featuredArticles.length > 0 && (
    <section class="py-16 sm:py-20">
      <Container>
        <header class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">
            Latest Research & Insights
          </h2>
          <p class="text-lg text-gray-500 dark:text-gray-400 max-w-2xl mx-auto">
            Stay informed with our most recent evidence-based articles.
          </p>
        </header>
        <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
          {featuredArticles.map((article: any) => (
              <a href={`/${article.data.pillar}/${article.data.cluster}/${article.id.replace('.mdx', '').split('/').pop()}`} class="block group focus:outline-none focus:ring-2 focus:ring-primary rounded-xl">
                <Card variant="interactive" class="h-full">
                  <div class="flex flex-col h-full">
                    <Badge
                      variant={article.data.stage === 'bofu' ? 'accent' : article.data.stage === 'mofu' ? 'info' : 'default'}
                      size="sm"
                    >
                      {article.data.stage === 'tofu' ? 'Awareness' : article.data.stage === 'mofu' ? 'Consideration' : 'Review'}
                    </Badge>
                    <h3 class="mt-3 text-base font-semibold text-gray-900 dark:text-white group-hover:text-primary transition-colors leading-snug">
                      {article.data.title}
                    </h3>
                    <p class="mt-2 text-sm text-gray-500 dark:text-gray-400 line-clamp-2 flex-1">
                      {article.data.description}
                    </p>
                    <div class="mt-auto pt-4 flex items-center justify-between text-xs text-gray-400">
                      <time>
                        {new Date(article.data.pubDate).toLocaleDateString('en-US', {
                          month: 'short', day: 'numeric',
                        })}
                      </time>
                      <span class="text-primary font-medium group-hover:text-primary-dark transition-colors">
                        Read more →
                      </span>
                    </div>
                  </div>
                </Card>
              </a>
          ))}
        </div>
        <div class="mt-10 text-center">
          <Button variant="outline" size="lg" href="/sitemap">
            View All Articles
          </Button>
        </div>
      </Container>
    </section>
  )}

  <section class="py-16 sm:py-20 bg-accent/5 dark:bg-accent/10 border-t border-b border-gray-200 dark:border-gray-800">
    <Container class="max-w-2xl">
      <header class="text-center mb-8">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">
          Weekly Wellness Insights
        </h2>
        <p class="text-lg text-gray-500 dark:text-gray-400">
          Join 10,000+ readers. Evidence-based tips for metabolic health after 40. No spam, unsubscribe anytime.
        </p>
      </header>
      <NewsletterBox />
    </Container>
  </section>

  <CTASection
    title="Discover Your Metabolic Type"
    subtitle="Take our 2-minute quiz and get personalized recommendations for your 40+ wellness journey — backed by the latest research."
    cta={{ label: 'Start Quiz →', href: '/quiz/metabolism-quiz' }}
    variant="glass"
  />
</Layout>
