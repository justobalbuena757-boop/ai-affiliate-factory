---
import Layout from '../layouts/Layout.astro';
import { Container, Card, Button, Badge, ProgressBar, Alert, Hero, FeaturesGrid, StatsGrid, CTASection } from 'design-system-base';
import { getCollection } from 'astro:content';
import NewsletterBox from '../components/NewsletterBox.astro';

const pillars = await getCollection('pillars');

const features = [
  {
    icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>',
    title: 'Edge Performance',
    description: 'Deployed on Cloudflare with static generation. Lightning-fast load times and global scalability.',
  },
  {
    icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>',
    title: 'Atomic Design System',
    description: 'Svelte 5 components with CVA, clsx and tailwind-merge. Brand-agnostic via CSS custom properties.',
  },
  {
    icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>',
    title: 'Native Multi-tenant',
    description: 'Each tenant overrides tokens in theme.css. Zero code duplication, maximum visual flexibility.',
  },
  {
    icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"/></svg>',
    title: 'MDX + DAG Content',
    description: 'Pydantic pipeline: TOFU → MOFU → BOFU. Automated generation via directed graphs with LLM.',
  },
  {
    icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>',
    title: 'Knowledge Graph',
    description: 'FalkorDB for article-product-user relationships. BI, recommendations and GraphRAG optimization.',
  },
  {
    icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
    title: 'Dark Mode Native',
    description: 'Full prefers-color-scheme support. All components adapt automatically to dark mode.',
  },
];

const stats = [
  { value: '13+', label: 'Atomic Components' },
  { value: '5', label: 'Variants per component' },
  { value: '3', label: 'Layers (Atom → Molecule → Organism)' },
  { value: '∞', label: 'Tenant combinations' },
];
---

<Layout
  title="Metabolic 40+ — Coffee & Wellness for Healthy Aging"
  description="Science-backed content about metabolic health, coffee, sleep, and healthy aging for adults over 40. Transform your daily habits."
  image="https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=1200&q=80"
  type="website"
>
  <Hero
    title="Boost Your Metabolism After 40"
    subtitle="Science-backed content about coffee, sleep, and metabolic health. Discover how your daily habits can transform your health."
    primaryCta={{ label: 'Explore Coffee & Wellness', href: '/coffee-wellness' }}
    secondaryCta={{ label: 'Learn About Sleep & Recovery', href: '/sleep-recovery' }}
    variant="gradient"
    backgroundImage="https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=1400&q=80"
  />

  <!-- Content Pillars -->
  {pillars.length > 0 && (
    <section class="py-16 sm:py-20">
      <Container>
        <header class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">
            Content Pillars
          </h2>
          <p class="text-gray-500 dark:text-gray-400 max-w-2xl mx-auto">
            Explore our curated content designed to guide you through the metabolic health journey.
          </p>
        </header>
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3 max-w-5xl mx-auto">
          {pillars.map((p: typeof pillars[number]) => (
            <a href={`/${p.id.replace('.mdx', '')}`} class="block group">
              <Card variant="interactive" class="h-full text-center">
                <div class="py-4">
                  {p.data.icon && <span class="text-4xl mb-4 block">{p.data.icon}</span>}
                  <h3 class="text-xl font-bold text-gray-900 dark:text-white group-hover:text-primary transition-colors">
                    {p.data.title}
                  </h3>
                  <p class="mt-3 text-sm text-gray-500 dark:text-gray-400 leading-relaxed">
                    {p.data.description}
                  </p>
                  <span class="mt-4 inline-block text-sm font-semibold text-primary group-hover:underline">
                    Explore Articles →
                  </span>
                </div>
              </Card>
            </a>
          ))}
        </div>
      </Container>
    </section>
  )}

  <!-- Component Showcase -->
  <section class="py-16 sm:py-20 bg-gray-50 dark:bg-gray-800/20 border-t border-gray-200 dark:border-gray-800">
    <Container>
      <header class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">
          Design System
        </h2>
        <p class="text-gray-500 dark:text-gray-400 max-w-2xl mx-auto">
          Atomic design system with Svelte 5, CVA, and Tailwind CSS 4. All components adapt to dark mode automatically.
        </p>
      </header>
      <div class="space-y-20">

      <section>
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Badges</h2>
        <p class="text-gray-500 dark:text-gray-400 mb-6">Semantic variants with CVA</p>
        <div class="flex flex-wrap gap-3">
          <Badge variant="default">Default</Badge>
          <Badge variant="success">Success</Badge>
          <Badge variant="warning">Warning</Badge>
          <Badge variant="error">Error</Badge>
          <Badge variant="info">Info</Badge>
          <Badge variant="accent">Accent</Badge>
          <Badge variant="default" size="sm">Small</Badge>
          <Badge variant="info" size="sm">Info sm</Badge>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Buttons</h2>
        <p class="text-gray-500 dark:text-gray-400 mb-6">5 variants × 3 sizes with CVA</p>
        <div class="space-y-6">
          <div class="flex flex-wrap gap-3 items-center">
            <Button variant="primary">Primary</Button>
            <Button variant="secondary">Secondary</Button>
            <Button variant="ghost">Ghost</Button>
            <Button variant="outline">Outline</Button>
            <Button variant="link">Link</Button>
          </div>
          <div class="flex flex-wrap gap-3 items-center">
            <Button variant="primary" size="sm">Small</Button>
            <Button variant="primary" size="md">Medium</Button>
            <Button variant="primary" size="lg">Large</Button>
            <Button variant="outline" size="sm" disabled>Disabled</Button>
            <Button variant="primary" href="#">Link Button</Button>
          </div>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Cards</h2>
        <p class="text-gray-500 dark:text-gray-400 mb-6">5 visual variants with CVA</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <Card title="Default" variant="default">
            <p class="text-gray-600 dark:text-gray-400 text-sm">Standard card with soft shadow.</p>
          </Card>
          <Card title="Elevated" variant="elevated">
            <p class="text-gray-600 dark:text-gray-400 text-sm">Stronger shadow to stand out.</p>
          </Card>
          <Card title="Bordered" variant="bordered">
            <p class="text-gray-600 dark:text-gray-400 text-sm">Subtle defined border style.</p>
          </Card>
          <Card title="Glass" variant="glass">
            <p class="text-gray-600 dark:text-gray-400 text-sm">Glassmorphism with backdrop-blur.</p>
          </Card>
          <Card title="Interactive" variant="interactive">
            <p class="text-gray-600 dark:text-gray-400 text-sm">Hover with elevation and translate.</p>
          </Card>
          <Card variant="elevated">
            <div class="flex flex-col items-center text-center">
              <div class="w-12 h-12 rounded-full bg-primary/10 text-primary flex items-center justify-center mb-3">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <h3 class="font-semibold text-gray-900 dark:text-white mb-1">No title</h3>
              <p class="text-gray-500 dark:text-gray-400 text-sm">Content-only mode.</p>
            </div>
          </Card>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Alerts</h2>
        <p class="text-gray-500 dark:text-gray-400 mb-6">4 semantic variants with icon and dismiss</p>
        <div class="space-y-4">
          <Alert variant="info" title="Information" icon>
            This is an informational alert. The user should read this message.
          </Alert>
          <Alert variant="success" title="Operation Successful" icon dismissible>
            Your changes have been saved. You can close this notice.
          </Alert>
          <Alert variant="warning" title="Warning" icon>
            This action cannot be undone. Please review before continuing.
          </Alert>
          <Alert variant="error" title="Critical Error" icon dismissible>
            Could not connect to the server. Please try again later.
          </Alert>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Progress Bars</h2>
        <p class="text-gray-500 dark:text-gray-400 mb-6">Color variants, sizes and animation</p>
        <div class="space-y-6 max-w-xl">
          <ProgressBar value={75} label="Overall progress" variant="primary" />
          <ProgressBar value={45} label="Downloading..." variant="success" size="sm" />
          <ProgressBar value={90} label="Almost ready" variant="accent" size="lg" animated />
          <div class="flex gap-4">
            <ProgressBar value={33} label="Warning" variant="warning" size="sm" class="flex-1" />
            <ProgressBar value={66} label="Error" variant="error" size="sm" class="flex-1" />
          </div>
        </div>
      </section>

      <FeaturesGrid
        title="Platform Features"
        subtitle="Atomic design system, multi-tenant via CSS variables, edge deployment, and automated content pipeline."
        features={features}
        columns={3}
      />

      <StatsGrid
        stats={stats}
        columns={4}
        variant="gradient"
        class="rounded-2xl"
      />

    </div>
    </Container>
  </section>

  <CTASection
    title="Ready to Transform Your Morning Coffee?"
    subtitle="Join thousands of people over 40 who have discovered the metabolic benefits of enhanced coffee."
    cta={{ label: 'Visit Java Burn Official Site', href: 'https://www.javaburn.net/' }}
    variant="glass"
  />

  <section class="py-12 sm:py-16">
    <Container>
      <NewsletterBox />
    </Container>
  </section>
</Layout>
