---
import Layout from '../layouts/Layout.astro';
import { Container, Card, Button, CTASection, Hero } from 'design-system-base';
import { getCollection } from 'astro:content';
import NewsletterBox from '../components/NewsletterBox.astro';

const pillars = await getCollection('pillars');

const allPosts = await getCollection('blog');
const publishedPosts = allPosts.filter(p => !p.data.draft).sort((a, b) => b.data.pubDate - a.data.pubDate);
const trendingPosts = publishedPosts.slice(0, 3);
---

<Layout
  title="Metabolic 40+ — Evidence-Based Wellness Intelligence for Adults 40+"
  description="Research-driven insights on metabolism, coffee, sleep, hormones, and healthy aging for adults over 40."
  image="/images/hero-coffe.png"
  type="website"
>
  <Hero
    title="Evidence-Based Wellness Intelligence for Adults 40+"
    subtitle="Expertly curated insights on metabolism, coffee, sleep, hormones, and healthy aging to help adults over 40 feel energized, strong, and in control."
    primaryCta={{ label: 'Explore Insights', href: '/coffee-wellness' }}
    secondaryCta={{ label: 'Take the Quiz', href: '/quiz/metabolism-quiz' }}
    variant="gradient"
    backgroundImage="/images/hero-coffe.png"
  />

  <section class="py-4 border-b border-gray-200 dark:border-gray-800">
    <Container>
      <div class="flex flex-wrap justify-center gap-6 text-xs sm:text-sm text-gray-500 dark:text-gray-400">
        <span>✓ Research Curated</span>
        <span>✓ Evidence Referenced</span>
        <span>✓ AI-Assisted Editorial Intelligence</span>
        <span>✓ Human Reviewed</span>
        <span>✓ Updated Weekly</span>
        <span>✓ Transparent & Honest</span>
      </div>
    </Container>
  </section>

  {pillars.length > 0 && (
    <section class="py-16 sm:py-20">
      <Container>
        <header class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">
            Explore Research Topics
          </h2>
          <p class="text-gray-500 dark:text-gray-400 max-w-2xl mx-auto">
            Deep-dive into evidence-based wellness topics for healthy aging after 40.
          </p>
        </header>
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3 max-w-5xl mx-auto">
          {pillars.map((p) => (
            <a href={`/${p.id.replace('.mdx', '')}`} class="block group">
              <Card variant="interactive" class="h-full text-center">
                <div class="py-4">
                  {p.data.icon && <span class="text-4xl mb-4 block">{p.data.icon}</span>}
                  <h3 class="text-xl font-bold text-gray-900 dark:text-white group-hover:text-primary transition-colors">
                    {p.data.title}
                  </h3>
                  <p class="mt-3 text-sm text-gray-500 dark:text-gray-400 leading-relaxed">
                    {p.data.description}
                  </p>
                  <span class="mt-4 inline-block text-sm font-semibold text-primary group-hover:underline">
                    Explore Articles →
                  </span>
                </div>
              </Card>
            </a>
          ))}
        </div>
      </Container>
    </section>
  )}

  <section class="py-16 bg-gray-50 dark:bg-gray-800/20">
    <Container>
      <h2 class="text-3xl font-bold text-center mb-12">Most Read This Week</h2>
      <div class="grid md:grid-cols-3 gap-8">
        {trendingPosts.map(post => (
          <a href={`/${post.data.pillar}/${post.data.cluster}/${post.id.replace('.mdx', '').split('/').pop()}`} class="group">
            <Card variant="interactive" class="h-full">
              <h3 class="text-xl font-semibold group-hover:text-primary transition">
                {post.data.title}
              </h3>
              <p class="text-sm text-gray-500 mt-2">{new Date(post.data.pubDate).toDateString()}</p>
              <p class="mt-2 text-gray-600 dark:text-gray-400 line-clamp-3">
                {post.data.description}
              </p>
            </Card>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <section class="py-16">
    <Container>
      <div class="bg-gradient-to-r from-primary/10 to-secondary/10 rounded-2xl p-8 text-center">
        <h2 class="text-2xl font-bold">Discover Your Metabolic Type</h2>
        <p class="mt-2 text-gray-600 dark:text-gray-400 max-w-xl mx-auto">
          Take our 2-minute quiz and get personalized recommendations for your 40+ wellness journey.
        </p>
        <Button variant="primary" size="lg" href="/quiz/metabolism-quiz" class="mt-6">
          Start Quiz →
        </Button>
      </div>
    </Container>
  </section>

  <section class="py-16 bg-gray-50 dark:bg-gray-800/20">
    <Container>
      <div class="flex flex-col md:flex-row gap-12 items-center">
        <div class="flex-1">
          <h2 class="text-3xl font-bold">Calculate Your BMR</h2>
          <p class="mt-4 text-gray-600 dark:text-gray-400">
            Knowing your Basal Metabolic Rate is the first step to adjust your nutrition after 40.
          </p>
          <Button variant="outline" href="/calculators/bmr-calculator" class="mt-6">
            Use Calculator →
          </Button>
        </div>
        <div class="flex-1 bg-white dark:bg-gray-800 rounded-xl shadow-lg p-6 text-center">
          <p class="text-sm text-gray-500">Quick preview: age, weight, height → BMR</p>
          <p class="text-xs text-gray-400 mt-2">(Full interactive calculator on dedicated page)</p>
        </div>
      </div>
    </Container>
  </section>

  <section class="py-16">
    <Container>
      <Card variant="glass" class="text-center max-w-3xl mx-auto">
        <h2 class="text-2xl font-bold">Free 7-Day Metabolic Meal Plan</h2>
        <p class="mt-2 text-gray-600 dark:text-gray-400">
          Download our PDF with coffee-enhanced recipes and weekly meal prep guide.
        </p>
        <form action="/api/subscribe" method="POST" class="mt-6 flex flex-col sm:flex-row gap-3 justify-center">
          <input
            type="email"
            name="email"
            placeholder="Your email address"
            required
            class="px-4 py-2 border rounded-lg dark:bg-gray-700 w-full sm:w-64"
          />
          <Button variant="primary" type="submit">Get Instant Access</Button>
        </form>
        <p class="text-xs text-gray-400 mt-4">We respect your privacy. Unsubscribe anytime.</p>
      </Card>
    </Container>
  </section>

  <CTASection
    title="Editor’s Research Pick: Java Burn"
    subtitle="Clinically-studied coffee formula for metabolic support. Read our evidence-based review."
    cta={{
      label: 'Read the Full Review →',
      href: '/coffee-wellness/coffee-metabolism/java-burn-review-2025-does-it-work-after-40',
    }}
    variant="glass"
  />

  <section class="py-12 sm:py-16">
    <Container>
      <NewsletterBox />
    </Container>
  </section>
</Layout>

<style>
.line-clamp-3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
</style>