---
import Layout from "../layouts/Layout.astro";
import {
	Container,
	Button,
	Hero,
	CTASection,
	FeaturesGrid,
	NewsletterSignup,
	ArticleCard,
} from "design-system-base";
import tenant from "../config/tenant.json";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { STAGE_LABELS } from "../lib/stage";

const brand = tenant.brand;
const pillars = await getCollection("pillars");
const allArticles = await getCollection("articles");
const published = allArticles
	.filter((p: CollectionEntry<"articles">) => !p.data.draft)
	.sort(
		(a: CollectionEntry<"articles">, b: CollectionEntry<"articles">) =>
			b.data.pubDate - a.data.pubDate,
	);

const featuredArticles = published.slice(0, 3);
const editorsPicks = published
	.filter((a: CollectionEntry<"articles">) => a.data.stage === "bofu")
	.slice(0, 2);

const trustStats = [
	{ value: "10K+", label: "Monthly Readers" },
	{ value: "50+", label: "Research Articles" },
	{ value: "100+", label: "Clinical Studies" },
	{ value: "4.8★", label: "Reader Rating" },
];

import { iconSvg } from "../lib/icons";

const researchBadges = [
	{ label: "Expert Reviewed", icon: "✓" },
	{ label: "Evidence‑Based", icon: "✓" },
	{ label: "Updated Weekly", icon: "✓" },
	{ label: "Transparent AI", icon: "✓" },
];

const pillarFeatures = pillars.map((p: CollectionEntry<"pillars">) => ({
	icon: p.id === "coffee-wellness" ? iconSvg.coffee : iconSvg.bed,
	image: p.data.ogImage || '',
	title: p.data.title,
	description: p.data.description,
	href: `/${p.id}`,
}));
---

<Layout
  title={`${brand.name} | ${brand.tagline}`}
  description={brand.description}
  image={brand.defaultOgImage}
  type="website"
  heroImage={brand.defaultOgImage}
>
  <Hero
    title="Evidence-Based Wellness Intelligence for Adults 40+"
    subtitle="Expertly curated insights on metabolism, coffee, sleep, hormones, and healthy aging — backed by peer-reviewed research and reviewed by our editorial team."
    primaryCta={{ label: 'Explore Research', href: '/coffee-wellness' }}
    secondaryCta={{ label: 'Take the Quiz', href: '/quiz/metabolism-quiz' }}
    variant="gradient"
    backgroundImage={brand.defaultOgImage}
  />

  <section class="py-10 sm:py-12 bg-muted/5 dark:bg-surface-dark/30 border-y border-border dark:border-border-dark">
    <Container>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {trustStats.map((stat) => (
          <div class="text-center">
            <div class="text-2xl sm:text-3xl lg:text-4xl font-bold text-primary">
              {stat.value}
            </div>
            <div class="mt-1 text-xs sm:text-sm text-muted dark:text-muted-dark font-medium uppercase tracking-wider">
              {stat.label}
            </div>
          </div>
        ))}
      </div>
      <div class="mt-6 pt-6 border-t border-border/50 dark:border-border-dark/50 flex flex-wrap items-center justify-center gap-x-8 gap-y-2 text-xs sm:text-sm text-muted dark:text-muted-dark">
        {researchBadges.map((badge) => (
          <span class="inline-flex items-center gap-1.5">
            <span class="w-4 h-4 text-success shrink-0" set:html={iconSvg.check} />
            {badge.label}
          </span>
        ))}
      </div>
    </Container>
  </section>

  {pillarFeatures.length > 0 && (
    <FeaturesGrid
      title="Explore Research Topics"
      subtitle="Deep-dive into evidence-based wellness topics curated for healthy aging after 40."
      features={pillarFeatures}
      columns={{ base: 1, md: 2, lg: 3 }}
    />
  )}

  {featuredArticles.length > 0 && (
    <section class="py-16 sm:py-20">
      <Container>
        <header class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-foreground dark:text-foreground-dark mb-4">
            Latest Research & Insights
          </h2>
          <p class="text-lg text-muted dark:text-muted-dark max-w-2xl mx-auto">
            Stay informed with our most recent evidence-based articles.
          </p>
        </header>
        <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
          {featuredArticles.map((article: any) => {
            const slug = article.id.replace('.mdx', '').split('/').pop();
            return (
              <ArticleCard
                title={article.data.title}
                excerpt={article.data.description}
                image={article.data.ogImage || ''}
                category={STAGE_LABELS[article.data.stage] || article.data.stage}
                author={article.data.author?.name || brand.companyName}
                date={new Date(article.data.pubDate).toLocaleDateString('en-US', {
                  month: 'short', day: 'numeric', year: 'numeric',
                })}
                url={`/${article.data.pillar}/${article.data.cluster}/${slug}`}
                variant="default"
              />
            );
          })}
        </div>
        <div class="mt-12 text-center">
          <Button variant="outline" size="lg" href="/sitemap">
            View All Articles →
          </Button>
        </div>
      </Container>
    </section>
  )}

  {editorsPicks.length > 0 && (
    <section class="py-16 sm:py-20 bg-muted/5 dark:bg-surface-dark/20">
      <Container>
        <header class="text-center mb-12">
          <span class="inline-block text-xs font-semibold uppercase tracking-widest text-accent mb-4">Curated by Our Team</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-foreground dark:text-foreground-dark mb-4">
            Editor's Picks
          </h2>
          <p class="text-lg text-muted dark:text-muted-dark max-w-2xl mx-auto">
            Our team's top-rated research and analysis for metabolic health after 40.
          </p>
        </header>
        <div class="grid md:grid-cols-2 gap-6 lg:gap-8 max-w-4xl mx-auto">
          {editorsPicks.map((article: any) => {
            const slug = article.id.replace('.mdx', '').split('/').pop();
            return (
              <div class="relative">
                <div class="absolute -inset-0.5 bg-gradient-to-br from-accent/20 to-accent/5 rounded-2xl blur-sm opacity-60" aria-hidden="true" />
                <div class="relative">
                  <ArticleCard
                    title={article.data.title}
                    excerpt={article.data.description}
                    image={article.data.ogImage || ''}
                    category="Editor's Choice"
                    author={article.data.author?.name || brand.companyName}
                    date={new Date(article.data.pubDate).toLocaleDateString('en-US', {
                      month: 'short', day: 'numeric', year: 'numeric',
                    })}
                    url={`/${article.data.pillar}/${article.data.cluster}/${slug}`}
                    variant="featured"
                  />
                </div>
              </div>
            );
          })}
        </div>
      </Container>
    </section>
  )}

  <section class="py-16 sm:py-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-accent/5 via-transparent to-primary/5" aria-hidden="true" />
    <Container class="relative max-w-2xl">
      <header class="text-center mb-8">
        <h2 class="text-3xl sm:text-4xl font-bold text-foreground dark:text-foreground-dark mb-4">
          Weekly Wellness Insights
        </h2>
        <p class="text-lg text-muted dark:text-muted-dark">
          Join 10,000+ readers. Evidence-based tips for metabolic health after 40. No spam, unsubscribe anytime.
        </p>
      </header>
      <NewsletterSignup variant="banner" />
    </Container>
  </section>

  <CTASection
    title="Discover Your Metabolic Type"
    subtitle="Take our 2-minute quiz and get personalized recommendations for your 40+ wellness journey — backed by the latest research."
    cta={{ label: 'Start Quiz →', href: '/quiz/metabolism-quiz' }}
    variant="glass"
  />
</Layout>
