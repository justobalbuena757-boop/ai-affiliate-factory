---
import Layout from '../../layouts/Layout.astro';
import { Container, Card, Button } from 'design-system-base';
---

<Layout
  title="BMR Calculator — Metabolic 40+"
  description="Calculate your Basal Metabolic Rate and understand your calorie needs after 40. Science-backed calculator with detailed insights."
  type="website"
>
  <Container class="py-16 sm:py-20 max-w-3xl">
    <header class="mb-12 text-center">
      <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">
        BMR Calculator
      </h1>
      <p class="text-gray-500 dark:text-gray-400 max-w-xl mx-auto">
        Calculate your Basal Metabolic Rate – the calories your body needs at rest. 
        After 40, metabolism naturally slows by 2-5% per decade.
      </p>
    </header>

    <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-xl p-6 sm:p-10 border border-gray-200 dark:border-gray-800">
      <form id="bmr-form" class="space-y-8">
        <div>
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
            <span>👤</span> Your Stats
          </h3>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="age" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Age</label>
              <input
                type="number"
                id="age"
                min="40"
                max="100"
                value="45"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-700 dark:bg-gray-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary"
                required
              />
            </div>
            <div>
              <label for="weight" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Weight (lbs)</label>
              <input
                type="number"
                id="weight"
                min="100"
                max="300"
                value="180"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-700 dark:bg-gray-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary"
                required
              />
            </div>
          </div>
        </div>

        <div>
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
            <span>📏</span> Dimensions
          </h3>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="height" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Height (in)</label>
              <input
                type="number"
                id="height"
                min="60"
                max="84"
                value="70"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-700 dark:bg-gray-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary"
                required
              />
              <p class="text-xs text-gray-400 mt-1">Typical: 5'10" = 70 inches</p>
            </div>
            <div>
              <label for="activity" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Activity Level</label>
              <select
                id="activity"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-700 dark:bg-gray-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary"
              >
                <option value="1.2">Sedentary (little/no exercise)</option>
                <option value="1.375">Light (1-3 days/week)</option>
                <option value="1.55" selected>Moderate (3-5 days/week)</option>
                <option value="1.725">Active (6-7 days/week)</option>
                <option value="1.9">Very Active (manual labor)</option>
              </select>
            </div>
          </div>
        </div>

        <Button type="submit" variant="primary" class="w-full py-3 text-lg">
          Calculate My Metabolism
        </Button>
      </form>

      <div id="result" class="mt-8 hidden">
        <div class="bg-gradient-to-r from-primary/10 to-secondary/10 rounded-xl p-6 text-center">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Your Metabolic Profile</h3>
          <div class="grid gap-4 sm:grid-cols-3">
            <div>
              <p class="text-2xl font-bold text-primary" id="bmr-value">-</p>
              <p class="text-sm text-gray-500 dark:text-gray-400">BMR (calories/day)</p>
            </div>
            <div>
              <p class="text-2xl font-bold text-primary" id="maintenance-value">-</p>
              <p class="text-sm text-gray-500 dark:text-gray-400">Maintenance</p>
            </div>
            <div>
              <p class="text-2xl font-bold text-primary" id="muscle-value">-</p>
              <p class="text-sm text-gray-500 dark:text-gray-400">Muscle Building</p>
            </div>
          </div>
        </div>

        <Card variant="bordered" class="mt-6">
          <h4 class="font-semibold text-gray-900 dark:text-white mb-2">What This Means</h4>
          <ul class="text-sm text-gray-600 dark:text-gray-400 space-y-2">
            <li>• BMR is your baseline calorie burn at complete rest</li>
            <li>• Maintenance includes light activity throughout the day</li>
            <li>• Muscle building requires a caloric surplus of ~200 calories</li>
            <li>• <strong>After 40, aim for the higher end</strong> of these ranges</li>
          </ul>
        </Card>

        <p class="mt-4 text-xs text-gray-500 dark:text-gray-400 text-center">
          Note: After 40, metabolism slows ~2-5% per decade. Adjust calories accordingly.
        </p>
      </div>
    </div>

    <div class="mt-8 text-center">
      <a href="/" class="text-sm text-primary hover:underline">← Back to Home</a>
    </div>
  </Container>

  <script is:inline>
    document.getElementById('bmr-form').addEventListener('submit', function(e) {
      e.preventDefault();

      const age = parseInt(document.getElementById('age').value);
      const weight = parseInt(document.getElementById('weight').value);
      const height = parseInt(document.getElementById('height').value);
      const activity = parseFloat(document.getElementById('activity').value);

      const bmr = Math.round(655 + (4.35 * weight) + (4.7 * height) - (4.7 * age));
      const maintenance = Math.round(bmr * activity);
      const muscleGain = Math.round(maintenance + 200);

      document.getElementById('bmr-value').textContent = bmr.toLocaleString();
      document.getElementById('maintenance-value').textContent = maintenance.toLocaleString();
      document.getElementById('muscle-value').textContent = muscleGain.toLocaleString();
      document.getElementById('result').classList.remove('hidden');
    });

    document.getElementById('bmr-form').dispatchEvent(new Event('submit'));
  </script>
</Layout>