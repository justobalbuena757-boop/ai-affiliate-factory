---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import { Container, Button } from 'design-system-base';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import tenant from '../config/tenant.json';

const pillars = await getCollection('pillars');
const siteUrl = (Astro.site?.toString() || tenant.brand.url).replace(/\/$/, '');
---

<Layout
  title={`Page Not Found — ${tenant.brand.name}`}
  description="The page you are looking for does not exist. Browse our content pillars or use the sitemap to find what you need."
  type="website"
  noindex={true}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: '404 — Page Not Found',
    url: `${siteUrl}/404`,
  }}
>
  <div class="min-h-[60vh] flex items-center justify-center py-20">
    <Container class="max-w-2xl text-center">
      <div class="mb-8">
        <span class="text-8xl sm:text-9xl font-black text-gray-100 dark:text-gray-800 select-none">404</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4 -mt-6">
        Page Not Found
      </h1>
      <p class="text-lg text-gray-500 dark:text-gray-400 mb-8 max-w-md mx-auto leading-relaxed">
        The page you are looking for may have been moved, updated, or no longer exists. Let us help you find what you need.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-12">
        <Button variant="primary" size="lg" href="/">
          Go Home
        </Button>
        <Button variant="outline" size="lg" href="/sitemap">
          View Sitemap
        </Button>
      </div>
      <div class="border-t border-gray-200 dark:border-gray-800 pt-10">
        <h2 class="text-sm font-bold text-gray-900 dark:text-white uppercase tracking-wider mb-5">
          Explore Our Topics
        </h2>
        <div class="flex flex-wrap justify-center gap-2">
          {pillars.map((p: CollectionEntry<'pillars'>) => (
            <a
              href={`/${p.id.replace('.mdx', '')}`}
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-gray-50 dark:bg-gray-800/50 hover:bg-gray-100 dark:hover:bg-gray-800 text-sm font-medium text-gray-700 dark:text-gray-300 hover:text-primary transition-colors"
            >
              <Icon name={p.id === 'coffee-wellness' ? 'lucide:coffee' : 'lucide:moon'} class="w-4 h-4" />
              {p.data.title}
            </a>
          ))}
        </div>
      </div>
    </Container>
  </div>
</Layout>
