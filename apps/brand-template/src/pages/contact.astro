---
import Layout from '../layouts/Layout.astro';
import { Container } from 'design-system-base';
---

<Layout
  title="Contact Us — Metabolic 40+"
  description="Get in touch with the Metabolic 40+ team with questions or feedback."
  type="website"
>
  <Container class="py-16 sm:py-20 max-w-3xl">
    <header class="mb-12 text-center">
      <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">Contact Us</h1>
      <p class="text-gray-500 dark:text-gray-400">
        Have questions or feedback? We'd love to hear from you.
      </p>
    </header>

    <div class="grid gap-8">
      <section class="bg-gray-50 dark:bg-gray-800/30 rounded-xl p-6">
        <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Get in Touch</h2>
        <div class="space-y-4">
          <div>
            <span class="text-sm font-medium text-gray-500 dark:text-gray-400">Email</span>
            <p class="text-gray-900 dark:text-white">hello@metabolic40plus.com</p>
          </div>
          <div>
            <span class="text-sm font-medium text-gray-500 dark:text-gray-400">Business Inquiries</span>
            <p class="text-gray-900 dark:text-white">partnerships@metabolic40plus.com</p>
          </div>
        </div>
      </section>

      <section class="bg-gray-50 dark:bg-gray-800/30 rounded-xl p-6">
        <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Write to Us</h2>
        <form class="space-y-4">
          <div class="grid gap-4 sm:grid-cols-2">
            <input type="text" placeholder="First name" class="px-4 py-3 rounded-lg border dark:bg-gray-700 dark:border-gray-600" />
            <input type="text" placeholder="Last name" class="px-4 py-3 rounded-lg border dark:bg-gray-700 dark:border-gray-600" />
          </div>
          <input type="email" placeholder="Email address" class="w-full px-4 py-3 rounded-lg border dark:bg-gray-700 dark:border-gray-600" />
          <textarea placeholder="Your message" rows="5" class="w-full px-4 py-3 rounded-lg border dark:bg-gray-700 dark:border-gray-600"></textarea>
          <button type="submit" class="bg-primary text-white px-6 py-3 rounded-lg font-medium hover:bg-primary-dark transition-colors">
            Send Message
          </button>
        </form>
      </section>
    </div>
  </Container>
</Layout>