---
import Layout from "../../layouts/Layout.astro";
import { Container, Card } from "design-system-base";
---

<Layout
  title="About — Metabolic 40+ Editorial Team"
  description="Meet the Metabolic 40+ editorial team. We're a group of health researchers and content creators dedicated to evidence-based content for adults over 40."
  type="website"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'About Metabolic 40+',
    description: 'Learn about the Metabolic 40+ editorial team and our mission to provide evidence-based health content for adults over 40.',
  }}
>
  <Container class="py-12 sm:py-16">
    <article class="max-w-3xl mx-auto">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-gray-900 dark:text-white mb-4">
        About Metabolic 40+
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-400 mb-10 leading-relaxed">
        Evidence-based health content for adults over 40. We combine nutritional science, sleep research, and AI-powered content creation to help you thrive in your 40s, 50s, and beyond.
      </p>

      <section class="mb-10">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4 pb-2 border-b border-gray-200 dark:border-gray-700">Our Mission</h2>
        <p class="text-body text-gray-700 dark:text-gray-300 leading-relaxed">
          We believe that the second half of life can be the most vibrant. Our content is designed to help you navigate the metabolic changes that begin after 40 with science-backed strategies, honest product reviews, and practical daily habits you can start implementing today.
        </p>
      </section>

      <section class="mb-10" id="editorial-team">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4 pb-2 border-b border-gray-200 dark:border-gray-700">Editorial Team</h2>
        <p class="text-body text-gray-700 dark:text-gray-300 leading-relaxed mb-4">
          The Metabolic 40+ editorial team combines expertise in nutritional science, sleep physiology, exercise science, and AI-augmented content creation. Every article goes through a multi-step review process that includes:
        </p>
        <ul class="list-disc pl-6 space-y-2 text-body text-gray-700 dark:text-gray-300">
          <li>Research from peer-reviewed scientific literature</li>
          <li>Cross-referencing of clinical trial data</li>
          <li>Review of safety and quality standards for any products mentioned</li>
          <li>Plain-language editing for accessibility</li>
          <li>Fact-checking and medical disclaimer verification</li>
        </ul>
      </section>

      <section class="mb-10">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4 pb-2 border-b border-gray-200 dark:border-gray-700">Affiliate Disclosure</h2>
        <p class="text-body text-gray-700 dark:text-gray-300 leading-relaxed">
          Some of the links on this site are affiliate links. If you purchase through these links, we may earn a commission at no extra cost to you. We only recommend products we have researched and believe provide genuine value. Our editorial content is independent and not influenced by affiliate partnerships. <a href="/disclosure" class="text-primary underline">Read our full disclosure policy</a>.
        </p>
      </section>

      <section class="mb-10">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4 pb-2 border-b border-gray-200 dark:border-gray-700">Medical Disclaimer</h2>
        <p class="text-body text-gray-700 dark:text-gray-300 leading-relaxed">
          The content on Metabolic 40+ is for informational and educational purposes only. It is not intended as medical advice, diagnosis, or treatment. Always consult a qualified healthcare provider before making changes to your diet, exercise routine, or supplement regimen — especially if you have existing health conditions or take medications.
        </p>
      </section>
    </article>
  </Container>
</Layout>
