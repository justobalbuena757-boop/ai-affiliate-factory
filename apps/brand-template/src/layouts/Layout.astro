---
import '../styles/global.css';
import '../styles/theme.css';
import { getCollection } from 'astro:content';
import SEO from '../components/SEO.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  modifiedDate?: Date;
  author?: string;
  tags?: string[];
  noindex?: boolean;
  canonical?: string;
  jsonLd?: Record<string, any> | Record<string, any>[];
  frontmatter?: {
    author?: {
      name: string;
      sameAs: string[];
    };
  };
}

const {
  title,
  description,
  image,
  type,
  pubDate,
  modifiedDate,
  author,
  tags,
  noindex,
  canonical,
  jsonLd,
  frontmatter = {},
} = Astro.props;

const pillars = await getCollection('pillars');
const year = new Date().getFullYear();
const siteUrl = (Astro.site?.toString() || 'https://metabolic40plus.com').replace(/\/$/, '');

const siteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Metabolic 40+',
  description: 'Science-backed content about metabolic health, coffee, sleep, and healthy aging for adults over 40.',
  url: siteUrl,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl}/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Metabolic 40+',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  sameAs: [
    'https://twitter.com/metabolic40plus',
    'https://facebook.com/metabolic40plus',
    'https://linkedin.com/company/metabolic40plus',
  ],
};

const authorJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: frontmatter.author?.name || 'AI Affiliate Factory',
  sameAs: frontmatter.author?.sameAs || [],
};

const mergedJsonLd = jsonLd
  ? Array.isArray(jsonLd)
    ? [siteJsonLd, orgJsonLd, authorJsonLd, ...jsonLd]
    : [siteJsonLd, orgJsonLd, authorJsonLd, jsonLd]
  : [siteJsonLd, orgJsonLd, authorJsonLd];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      pubDate={pubDate}
      modifiedDate={modifiedDate}
      author={author}
      tags={tags}
      noindex={noindex}
      canonical={canonical}
      jsonLd={mergedJsonLd}
    />
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
    <script is:inline>
      function initThemeToggle() {
        const toggle = document.getElementById('theme-toggle');
        if (!toggle) {
          setTimeout(initThemeToggle, 50);
          return;
        }
        
        toggle.addEventListener('click', function() {
          const html = document.documentElement;
          const isDark = html.classList.contains('dark');
          if (isDark) {
            html.classList.remove('dark');
            localStorage.setItem('theme', 'light');
          } else {
            html.classList.add('dark');
            localStorage.setItem('theme', 'dark');
          }
        });
      }
      initThemeToggle();
    </script>
  </head>
  <body class="bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 min-h-screen antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-primary focus:text-white focus:rounded-lg outline-none">
      Skip to main content
    </a>

    <header class="sticky top-0 z-40 w-full border-b border-gray-200 dark:border-gray-800 bg-white/80 dark:bg-gray-900/80 backdrop-blur-lg">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <a href="/" class="flex items-center gap-2 text-lg font-bold text-gray-900 dark:text-white hover:text-primary transition-colors">
            <span class="text-xl">&#9886;</span>
            <span>Metabolic 40+</span>
          </a>

          <nav class="hidden sm:flex items-center gap-6" aria-label="Main navigation">
            {pillars.map((p: typeof pillars[number]) => (
              <a
                href={`/${p.id.replace('.mdx', '')}`}
                class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-primary dark:hover:text-primary transition-colors"
              >
                {p.data.icon && <span class="mr-1">{p.data.icon}</span>}
                {p.data.title.split('&')[0].trim()}
              </a>
            ))}
            <a
              href="https://www.javaburn.net/"
              class="text-sm font-semibold text-accent dark:text-accent hover:underline"
            >
              Shop Java Burn
            </a>
          </nav>

          <button
            id="theme-toggle"
            class="flex items-center justify-center w-9 h-9 rounded-lg text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
            aria-label="Toggle dark mode"
            type="button"
          >
            <svg class="w-5 h-5 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
            <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="border-t border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900/50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          <div>
            <h3 class="text-sm font-bold text-gray-900 dark:text-white uppercase tracking-wider mb-3">Metabolic 40+</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">
              Science-backed content about metabolic health, coffee, sleep, and healthy aging for adults over 40.
            </p>
          </div>
          <div>
            <h3 class="text-sm font-bold text-gray-900 dark:text-white uppercase tracking-wider mb-3">Content Pillars</h3>
            <ul class="space-y-2">
              {pillars.map((p: typeof pillars[number]) => (
                <li>
                  <a
                    href={`/${p.id.replace('.mdx', '')}`}
                    class="text-sm text-gray-500 dark:text-gray-400 hover:text-primary transition-colors"
                  >
                    {p.data.icon && <span class="mr-1.5">{p.data.icon}</span>}
                    {p.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="text-sm font-bold text-gray-900 dark:text-white uppercase tracking-wider mb-3">Disclosure</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">
              This site contains affiliate links. If you purchase through these links, we may earn a commission at no extra cost to you.
            </p>
          </div>
        </div>
        <div class="mt-8 pt-8 border-t border-gray-200 dark:border-gray-800 text-center">
          <p class="text-xs text-gray-400 dark:text-gray-500">
            &copy; {year} AI Affiliate Factory. All rights reserved.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
---