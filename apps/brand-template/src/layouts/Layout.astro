---
import '../styles/global.css';
import '../styles/theme.css';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import SEO from '../components/SEO.astro';
import ThemeScript from '../components/ThemeScript.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Footer from '../components/Footer.astro';
import MobileMenu from '../components/MobileMenu.astro';
import tenant from '../config/tenant.json';

interface NavLink {
  label: string;
  href: string;
  isExternal?: boolean;
  class?: string;
}

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  modifiedDate?: Date;
  author?: string;
  tags?: string[];
  noindex?: boolean;
  canonical?: string;
  jsonLd?: Record<string, any> | Record<string, any>[];
  frontmatter?: {
    author?: {
      name: string;
      sameAs: string[];
    };
  };
  heroImage?: string;
}

const {
  title,
  description,
  image,
  type,
  pubDate,
  modifiedDate,
  author,
  tags,
  noindex,
  canonical,
  jsonLd,
  frontmatter = {},
  heroImage,
} = Astro.props;

const pillars = await getCollection('pillars');
const siteUrl = (Astro.site?.toString() || tenant.brand.url).replace(/\/$/, '');
const brand = tenant.brand;
const nav = tenant.nav;

const siteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: brand.name,
  description: brand.description,
  url: siteUrl,
  ...(tenant.jsonLd?.searchAction && {
    potentialAction: {
      '@type': 'SearchAction',
      target: `${siteUrl}/?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  }),
};

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: brand.name,
  url: siteUrl,
  logo: `${siteUrl}${brand.favicon}`,
  sameAs: Object.values(tenant.social || {}),
};

const authorJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: frontmatter.author?.name || brand.companyName,
  sameAs: frontmatter.author?.sameAs || [],
};

const mergedJsonLd = jsonLd
  ? Array.isArray(jsonLd)
    ? [siteJsonLd, orgJsonLd, authorJsonLd, ...jsonLd]
    : [siteJsonLd, orgJsonLd, authorJsonLd, jsonLd]
  : [siteJsonLd, orgJsonLd, authorJsonLd];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      pubDate={pubDate}
      modifiedDate={modifiedDate}
      author={author}
      tags={tags}
      noindex={noindex}
      canonical={canonical}
      jsonLd={mergedJsonLd}
    />
    {heroImage && (
      <link rel="preload" as="image" href={heroImage} />
    )}
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap" />
    </noscript>
    <ThemeScript />
  </head>
  <body class="bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 min-h-screen antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-primary focus:text-white focus:rounded-lg outline-none">
      Skip to main content
    </a>

    <header class="sticky top-0 z-40 w-full border-b border-gray-200 dark:border-gray-800 bg-white/80 dark:bg-gray-900/80 backdrop-blur-lg" style="padding-top:env(safe-area-inset-top,0px)">
      <div class="max-w-6xl mx-auto px-4 tablet:px-6 md:px-8">
        <div class="flex items-center justify-between h-16">
          <a href="/" class="flex items-center gap-2 text-lg font-bold text-gray-900 dark:text-white hover:text-primary transition-colors">
            <Icon name="lucide:zap" class="w-6 h-6 text-primary" />
            <span>{brand.logoText}</span>
          </a>

          <MobileMenu pillars={pillars} />

          <nav class="hidden sm:flex items-center gap-6" aria-label="Main navigation">
            {pillars.map((p: any) => (
              <a
                href={`/${p.id.replace('.mdx', '')}`}
                class="flex items-center gap-1.5 text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-primary dark:hover:text-primary transition-colors"
              >
                <Icon name={p.id === 'coffee-wellness' ? 'lucide:coffee' : 'lucide:moon'} class="w-4 h-4" />
                {p.data.title.split('&')[0].trim()}
              </a>
            ))}
            {(nav?.primary as NavLink[] || []).map((link) => (
              <a
                href={link.href}
                class={link.class || "text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-primary transition-colors"}
                {...(link.isExternal ? { target: "_blank", rel: "noopener sponsored" } : {})}
              >
                {link.label}
              </a>
            ))}
          </nav>

          <ThemeToggle />
        </div>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <Footer pillars={pillars} />

    <script>
      (()=>{
        let u = localStorage.getItem('_vid');
        if (!u) { u = crypto.randomUUID?.() || 'v' + Date.now() + Math.random().toString(36).slice(2); localStorage.setItem('_vid', u); }
        const send = () => {
          const d = { uuid: u, url: location.href, title: document.title, referrer: document.referrer, screen: `${screen.width}x${screen.height}`, tz: Intl.DateTimeFormat().resolvedOptions().timeZone };
          (navigator.sendBeacon || ((url, body) => fetch(url, { method: 'POST', body, keepalive: true })))('/api/track', JSON.stringify(d));
        };
        const cb = () => {
          send();
          fetch('/api/visits?uuid=' + encodeURIComponent(u)).then(r => r.json()).then(d => {
            if (!d.visits?.length) return;
            const html = document.documentElement;
            html.dataset.visited = 'true';
            const count = d.visits.length;
            if (count > 5) html.dataset.visitedCount = '5+'; else html.dataset.visitedCount = String(count);
            const pages = d.visits.map((v: any) => v.url || '');
            if (pages.some((p: string) => p.includes('/coffee-wellness'))) html.dataset.visitedCoffee = '';
            if (pages.some((p: string) => p.includes('/sleep-recovery'))) html.dataset.visitedSleep = '';
            if (pages.some((p: string) => p.includes('/quiz'))) html.dataset.visitedQuiz = '';
          }).catch(() => {});
        };
        ('requestIdleCallback' in window ? requestIdleCallback : setTimeout)(cb, 100);
      })();
    </script>
  </body>
</html>
