---
import { cn } from 'design-system-base';
import Layout from './Layout.astro';
import { Container, Card, Button, Hero } from 'design-system-base';
import type { CollectionEntry } from 'astro:content';

interface Props {
  pillar: CollectionEntry<'pillars'>;
  articles: CollectionEntry<'articles'>[];
}

const { pillar, articles } = Astro.props;

const clusters = [...new Set(articles.map((a) => a.data.cluster))];
const sorted = articles.sort((a, b) => a.data.order - b.data.order);

const stageColors: Record<string, string> = {
  tofu: 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400',
  mofu: 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400',
  bofu: 'bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-400',
};
const stageLabels: Record<string, string> = { tofu: 'TOFU', mofu: 'MOFU', bofu: 'BOFU' };
const stageOrder = ['tofu', 'mofu', 'bofu'];
---

<Layout
  title={`${pillar.data.title} — Metabolic 40+`}
  description={pillar.data.description}
  image={pillar.data.ogImage}
  type="website"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: pillar.data.title,
    description: pillar.data.description,
    url: `${(Astro.site?.toString() || 'https://metabolic40plus.com').replace(/\/$/, '')}/${pillar.id.replace('.mdx', '')}`,
    isPartOf: {
      '@type': 'WebSite',
      name: 'Metabolic 40+',
    },
  }}
>
  <Hero
    title={pillar.data.title}
    subtitle={pillar.data.description}
    primaryCta={{ label: 'Explore Articles', href: `#articles` }}
    variant="gradient"
    backgroundImage={pillar.data.ogImage}
  />

  <section id="articles" class="py-16 sm:py-20 scroll-mt-20">
    <Container>
      {clusters.map((cluster) => {
        const clusterArticles = sorted.filter((a) => a.data.cluster === cluster);
        return (
          <section class="mb-20 last:mb-0">
            <header class="mb-10 text-center">
              <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white capitalize">
                {cluster.replace(/-/g, ' ')}
              </h2>
              <p class="mt-2 text-sm text-gray-500 dark:text-gray-400 max-w-xl mx-auto">
                {clusterArticles.length} article{clusterArticles.length !== 1 ? 's' : ''} in this cluster
              </p>
            </header>
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 max-w-5xl mx-auto">
              {stageOrder.map(stage => {
                const article = clusterArticles.find(a => a.data.stage === stage);
                if (!article) return null;
                const articleSlug = article.id.replace('.mdx', '').split('/').pop();
                return (
                  <article>
                    <a
                      href={`/${article.data.pillar}/${article.data.cluster}/${articleSlug}`}
                      class="block group h-full"
                    >
                      <Card variant="interactive" class="h-full">
                        <div class="flex flex-col h-full">
                          <div class="flex items-center justify-between mb-3">
                            <span
                              class={cn(
                                'inline-block text-xs font-semibold px-2.5 py-1 rounded-full',
                                stageColors[article.data.stage],
                              )}
                            >
                              {stageLabels[article.data.stage]}
                            </span>
                            <span class="text-xs text-gray-400">{article.data.order} of {clusterArticles.length}</span>
                          </div>
                          <h3 class="text-lg font-semibold text-gray-900 dark:text-white group-hover:text-primary transition-colors leading-snug">
                            {article.data.title}
                          </h3>
                          <p class="mt-2 text-sm text-gray-500 dark:text-gray-400 line-clamp-2 flex-1">
                            {article.data.description}
                          </p>
                          <time class="mt-4 text-xs text-gray-400 block">
                            {new Date(article.data.pubDate).toLocaleDateString('en-US', {
                              year: 'numeric', month: 'long', day: 'numeric',
                            })}
                          </time>
                        </div>
                      </Card>
                    </a>
                  </article>
                );
              })}
            </div>
          </section>
        );
      })}
    </Container>
  </section>
</Layout>
