---
import { cn } from "design-system-base";
import Layout from "./Layout.astro";
import {
	Container,
	Breadcrumb,
	CTASection,
	ArticleCard,
	AuthorBio,
	Hero,
	TableOfContents,
} from "design-system-base";
import AffiliateDisclosure from "../components/mdx/AffiliateDisclosure.astro";
import tenant from "../config/tenant.json";
import { STAGE_COLORS, STAGE_LABELS } from "../lib/stage";
import type { CollectionEntry } from "astro:content";

interface Props {
	article: CollectionEntry<"articles">;
	headings: { depth: number; slug: string; text: string }[];
	relatedArticles?: CollectionEntry<"articles">[];
	pillarEntry?: CollectionEntry<"pillars">;
}

const { article, headings, relatedArticles = [], pillarEntry } = Astro.props;
const { data } = article;

const articleSlug = article.id.replace(".mdx", "").split("/").pop();
const pillarSlug = data.pillar;
const clusterSlug = data.cluster;

const readingTime = Math.ceil(article.body?.split(/\s+/).length / 200) || 4;
const validHeadings = headings.filter((h) => h.depth <= 3 && h.slug);
const hasToc = validHeadings.length > 0;

const brand = tenant.brand;
const siteUrl = (Astro.site?.toString() || brand.url).replace(/\/$/, "");
const articleUrl = `${siteUrl}/${pillarSlug}/${clusterSlug}/${articleSlug}`;
const articleImage = data.ogImage || `${siteUrl}${brand.defaultOgImage}`;

const dateModified = (data as any).modifiedDate
	? new Date((data as any).modifiedDate)
	: data.pubDate;

const authorName = data.author || brand.companyName;
const authorUrl = `${siteUrl}/about`;
const pillarTitle =
	pillarEntry?.data?.title ||
	pillarSlug.replace(/-/g, " ").replace(/\b\w/g, (c: string) => c.toUpperCase());
const clusterTitle = clusterSlug
	.replace(/-/g, " ")
	.replace(/\b\w/g, (c: string) => c.toUpperCase());

const personJsonLd = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: authorName,
	url: authorUrl,
	jobTitle: "Editorial Team",
	worksFor: {
		"@type": "Organization",
		name: brand.name,
		url: siteUrl,
	},
	knowsAbout: [
		"Metabolic Health",
		"Sleep Science",
		"Healthy Aging",
		"Nutritional Science",
		"Exercise Physiology",
	],
};

const pillarTopics: Record<string, string> = {
	"coffee-wellness":
		"Coffee, Metabolism, Healthy Aging, Nutritional Supplements",
	"sleep-recovery":
		"Sleep Quality, Recovery, Hormonal Balance, Circadian Rhythm",
};

const articleJsonLd: any = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: data.title,
	description: data.description,
	image: {
		"@type": "ImageObject",
		url: articleImage,
		width: 1200,
		height: 630,
	},
	datePublished: data.pubDate.toISOString(),
	dateCreated: data.pubDate.toISOString(),
	dateModified: dateModified.toISOString(),
	author: {
		"@type": "Person",
		"@id": `${siteUrl}/about#editorial-team`,
		name: authorName,
		url: authorUrl,
	},
	publisher: {
		"@type": "Organization",
		"@id": `${siteUrl}#organization`,
		name: brand.name,
		logo: {
			"@type": "ImageObject",
			url: `${siteUrl}${brand.favicon}`,
			width: 64,
			height: 64,
		},
	},
	mainEntityOfPage: {
		"@type": "WebPage",
		"@id": articleUrl,
	},
	keywords: data.tags.join(", "),
	articleSection: pillarTitle,
	articleBody: data.description,
	inLanguage: "en-US",
	wordCount: article.body?.split(/\s+/).length || 0,
	about: {
		"@type": "Thing",
		name: pillarTitle,
		description: pillarTopics[pillarSlug] || "Metabolic Health, Wellness, Healthy Aging",
	},
	mentions: [
		{ "@type": "Thing", name: "Metabolic Health After 40" },
		{ "@type": "Thing", name: "Evidence-Based Wellness" },
		{ "@type": "Thing", name: "Healthy Aging" },
	],
};

const metabolicProductDesc =
	"Science-backed metabolic support supplement designed for adults over 40.";

const productCta = data.cta || {
	label: "Shop Now",
	href: "https://www.javaburn.net/",
};

if (productCta) {
	const productName = productCta.product || "Java Burn";
	if (data.stage === "bofu") {
		articleJsonLd.review = {
			"@type": "Review",
			name: data.title,
			reviewBody: data.description,
			datePublished: data.pubDate.toISOString(),
			author: {
				"@type": "Person",
				name: authorName,
			},
			itemReviewed: {
				"@type": "Product",
				name: productName,
				description:
					productCta.description ||
					"Flavorless, instant-dissolve metabolic support powder designed to be added to morning coffee.",
				brand: { "@type": "Brand", name: productName },
				...(productCta.offers && { offers: productCta.offers }),
				...(productCta.aggregateRating && {
					aggregateRating: productCta.aggregateRating,
				}),
			},
			reviewRating: {
				"@type": "Rating",
				ratingValue: productCta.ratingValue || "4.6",
				bestRating: "5",
				worstRating: "1",
			},
		};
	} else if (data.stage === "mofu") {
		articleJsonLd.review = {
			"@type": "Review",
			name: data.title,
			reviewBody: data.description,
			datePublished: data.pubDate.toISOString(),
			author: { "@type": "Person", name: authorName },
			itemReviewed: {
				"@type": "Product",
				name: productName,
				description: productCta.description || metabolicProductDesc,
			},
		};
	}
}

const ctaLabels: Record<string, string> = {
	tofu: "Start Reading",
	mofu: "Learn More",
	bofu: "Shop Now",
};
const ctaLabel = ctaLabels[data.stage] || "Start Reading";

const breadcrumbItems = [
	{ label: pillarTitle, href: `/${pillarSlug}` },
	{ label: clusterTitle, href: `/${pillarSlug}/${clusterSlug}` },
	{ label: data.title },
];

const breadcrumbJsonLd = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: "Home",
			item: siteUrl,
		},
		{
			"@type": "ListItem",
			position: 2,
			name: pillarTitle,
			item: `${siteUrl}/${pillarSlug}`,
		},
		{
			"@type": "ListItem",
			position: 3,
			name: clusterTitle,
			item: `${siteUrl}/${pillarSlug}/${clusterSlug}`,
		},
		{
			"@type": "ListItem",
			position: 4,
			name: data.title,
			item: articleUrl,
		},
	],
};
---

<Layout
  title={data.title}
  description={data.description}
  image={articleImage}
  type="article"
  pubDate={data.pubDate}
  author={data.author}
  tags={data.tags}
  canonical={articleUrl}
  jsonLd={[personJsonLd, articleJsonLd, breadcrumbJsonLd]}
>
  {data.ogImage ? (
    <>
      {data.stage !== 'tofu' && (
        <div class="bg-muted/5 dark:bg-surface-dark/30 border-b border-border dark:border-border-dark">
          <Container class="py-3">
            <Breadcrumb items={breadcrumbItems} />
          </Container>
        </div>
      )}
      <Hero
        title={data.title}
        subtitle={data.description}
        primaryCta={{ label: ctaLabel, href: '#article-content' }}
        variant={data.stage === 'tofu' ? 'gradient' : 'glass'}
        backgroundImage={data.ogImage}
      />
    </>
  ) : (
    <div class="bg-muted/5 dark:bg-surface-dark/30 border-b border-border dark:border-border-dark">
      <Container class="py-4">
        <Breadcrumb items={breadcrumbItems} />
      </Container>
    </div>
  )}

  <Container class="py-8 sm:py-12 lg:py-16" id="article-content">
    <main class="lg:grid lg:grid-cols-[1fr_280px] lg:gap-12">
      <article class="min-w-0">
        <header class="mb-10">
          <div class="flex items-center gap-3 mb-4">
            <span class={cn('inline-block text-xs font-semibold px-2.5 py-1 rounded-full', STAGE_COLORS[data.stage])}>
              {STAGE_LABELS[data.stage] || data.stage}
            </span>
            <span class="text-sm text-muted dark:text-muted-dark">
              {new Date(data.pubDate).toLocaleDateString('en-US', {
                year: 'numeric', month: 'long', day: 'numeric',
              })}
            </span>
            <span class="text-sm text-muted dark:text-muted-dark">&middot;</span>
            <span class="text-sm text-muted dark:text-muted-dark">{readingTime} min read</span>
          </div>

          {!data.ogImage && (
            <>
              <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-foreground dark:text-foreground-dark mb-4 leading-tight">
                {data.title}
              </h1>
              <p class="text-lg text-muted dark:text-muted-dark leading-relaxed">
                {data.description}
              </p>
            </>
          )}
        </header>

        {(data.stage === 'mofu' || data.stage === 'bofu') && (
          <AffiliateDisclosure
            product={productCta.product || 'Java Burn'}
            network="official website"
          />
        )}

        <div class="max-w-[70ch] mx-auto">
          <slot />
        </div>

        {data.tags.length > 0 && (
          <footer class="mt-10 flex flex-wrap gap-2">
            {data.tags.map((tag: string) => (
              <span class="inline-block text-xs font-medium px-2.5 py-1 rounded-full bg-muted/10 dark:bg-muted-dark/10 text-muted dark:text-muted-dark">
                #{tag}
              </span>
            ))}
          </footer>
        )}

        <AuthorBio
          name={data.author || brand.companyName}
          role="Editorial Team"
          bio="The AI Affiliate Factory editorial team combines nutritional science research, sleep science, and AI-powered content creation to deliver evidence-based health information specifically tailored for adults over 40."
          expertise={['Metabolic Health', 'Sleep Science', 'Healthy Aging']}
          publishDate={data.pubDate.toISOString()}
          lastUpdated={dateModified.toISOString()}
        />
      </article>

      {hasToc && (
        <aside class="hidden lg:block">
          <div class="sticky top-24 space-y-4">
            <TableOfContents headings={validHeadings} />

            <div class="p-5 bg-accent/5 dark:bg-accent/10 rounded-xl border border-accent/10 dark:border-accent/20">
              <h3 class="text-sm font-bold text-foreground dark:text-foreground-dark mb-2">{productCta.product || 'Try Java Burn'}</h3>
              <p class="text-xs text-muted dark:text-muted-dark mb-3 leading-relaxed">
                {productCta.sidebarDescription || 'Science-backed metabolic support in your morning coffee.'}
              </p>
              <a
                href={productCta.href}
                class="inline-block text-xs font-bold text-foreground-dark bg-accent hover:bg-accent-dark px-4 py-2 rounded-lg transition-colors w-full text-center no-underline"
              >
                {productCta.label}
              </a>
            </div>
          </div>
        </aside>
      )}
    </main>
  </Container>

  {relatedArticles.length > 0 && (
    <section class="bg-muted/5 dark:bg-surface-dark/30 border-t border-border dark:border-border-dark py-14 sm:py-18">
      <Container>
        <h2 class="text-2xl font-bold text-foreground dark:text-foreground-dark mb-8 text-center">
          Related Articles
        </h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 max-w-4xl mx-auto">
          {relatedArticles.slice(0, 3).map(r => {
            const rSlug = r.id.replace('.mdx', '').split('/').pop();
            return (
              <ArticleCard
                title={r.data.title}
                excerpt={r.data.description}
                category={STAGE_LABELS[r.data.stage] || r.data.stage}
                author={r.data.author}
                date={new Date(r.data.pubDate).toLocaleDateString('en-US', {
                  year: 'numeric', month: 'long', day: 'numeric',
                })}
                url={`/${r.data.pillar}/${r.data.cluster}/${rSlug}`}
                variant="default"
              />
            );
          })}
        </div>
      </Container>
    </section>
  )}

  <CTASection
    title={productCta.sectionTitle || 'Ready to Transform Your Health?'}
    subtitle={productCta.sectionSubtitle || 'Join thousands of people over 40 who have discovered the power of enhanced coffee for metabolism, sleep, and recovery.'}
    cta={{ label: productCta.ctaLabel || 'Visit Official Site', href: productCta.href }}
    variant="glass"
  />
</Layout>
