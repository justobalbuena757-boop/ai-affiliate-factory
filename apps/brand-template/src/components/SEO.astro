---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  modifiedDate?: Date;
  author?: string;
  tags?: string[];
  noindex?: boolean;
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description,
  canonical,
  image = '/og-default.jpg',
  type = 'website',
  pubDate,
  modifiedDate,
  author = 'AI Affiliate Factory',
  tags = [],
  noindex = false,
  jsonLd,
} = Astro.props;

const siteUrl = Astro.site?.toString() || 'https://metabolic40plus.com';
const canonicalUrl = canonical ? new URL(canonical, siteUrl).toString() : new URL(Astro.url.pathname, siteUrl).toString();
const imageUrl = image.startsWith('http') ? image : new URL(image, siteUrl).toString();

// SEO best practice: title 50-60 chars, description 120-155 chars
const TITLE_MAX = 60;
const DESCRIPTION_MAX = 155;

const truncate = (text: string, max: number): { text: string; truncated: boolean; charCount: number } => {
  if (text.length <= max) return { text, truncated: false, charCount: text.length };
  return { text: text.slice(0, max - 1).trimEnd() + '…', truncated: true, charCount: text.length };
};

const fullTitle = title.includes('Metabolic 40+') ? title : `${title} | Metabolic 40+`;
const titleResult = truncate(fullTitle, TITLE_MAX);
const descResult = truncate(description, DESCRIPTION_MAX);

if (titleResult.truncated) {
  console.warn(`[SEO] Title exceeds ${TITLE_MAX} chars (${titleResult.charCount}): "${fullTitle}"`);
}
if (descResult.truncated) {
  console.warn(`[SEO] Description exceeds ${DESCRIPTION_MAX} chars (${descResult.charCount}): "${description}"`);
}
---

<!-- Primary Meta Tags -->
<title>{titleResult.text}</title>
<meta name="title" content={titleResult.text} />
<meta name="description" content={descResult.text} />
<meta name="author" content={author} />
<link rel="canonical" href={canonicalUrl} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}

<!-- Hreflang — site is English-only but we declare explicitly for SEO clarity -->
<link rel="alternate" hreflang="en-US" href={canonicalUrl} />
<link rel="alternate" hreflang="en" href={canonicalUrl} />
<link rel="alternate" hreflang="x-default" href={canonicalUrl} />

<!-- Theme & App -->
<meta name="theme-color" content="#6366f1" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0a0a0f" media="(prefers-color-scheme: dark)" />
<meta name="application-name" content="Metabolic 40+" />
<meta name="apple-mobile-web-app-title" content="Metabolic 40+" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="format-detection" content="telephone=no" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={titleResult.text} />
<meta property="og:description" content={descResult.text} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content="Metabolic 40+" />
<meta property="og:locale" content="en_US" />
{pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
{modifiedDate && <meta property="article:modified_time" content={modifiedDate.toISOString()} />}
{author && <meta property="article:author" content={author} />}
{tags.map(tag => <meta property="article:tag" content={tag} />)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={titleResult.text} />
<meta name="twitter:description" content={descResult.text} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={title} />

<!-- Favicon & Apple Touch -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<!-- JSON-LD Structured Data -->
{jsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd, null, 0)} />
)}
