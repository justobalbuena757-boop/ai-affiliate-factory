---
import tenant from '../config/tenant.json';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  modifiedDate?: Date;
  author?: string;
  tags?: string[];
  noindex?: boolean;
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description,
  canonical,
  image,
  type = 'website',
  pubDate,
  modifiedDate,
  author,
  tags = [],
  noindex = false,
  jsonLd,
} = Astro.props;

const brand = tenant.brand;
const siteUrl = (Astro.site?.toString() || brand.url).replace(/\/$/, '');
const canonicalUrl = canonical ? new URL(canonical, siteUrl).toString() : new URL(Astro.url.pathname, siteUrl).toString();
const imageUrl = image
  ? image.startsWith('http') ? image : new URL(image, siteUrl).toString()
  : new URL(brand.defaultOgImage, siteUrl).toString();

const TITLE_MAX = 60;
const DESCRIPTION_MAX = 155;

const truncate = (text: string, max: number): { text: string; truncated: boolean; charCount: number } => {
  if (text.length <= max) return { text, truncated: false, charCount: text.length };
  return { text: text.slice(0, max - 1).trimEnd() + '…', truncated: true, charCount: text.length };
};

const separator = ` | ${brand.name}`;
const fullTitle = title.includes(brand.name) ? title : `${title}${separator}`;
const titleResult = truncate(fullTitle, TITLE_MAX);
const descResult = truncate(description, DESCRIPTION_MAX);

if (titleResult.truncated) {
  console.warn(`[SEO] Title exceeds ${TITLE_MAX} chars (${titleResult.charCount}): "${fullTitle}"`);
}
if (descResult.truncated) {
  console.warn(`[SEO] Description exceeds ${DESCRIPTION_MAX} chars (${descResult.charCount}): "${description}"`);
}
---

<title>{titleResult.text}</title>
<meta name="title" content={titleResult.text} />
<meta name="description" content={descResult.text} />
<meta name="author" content={author || brand.companyName} />
<link rel="canonical" href={canonicalUrl} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}

<link rel="alternate" hreflang="en-US" href={canonicalUrl} />
<link rel="alternate" hreflang="en" href={canonicalUrl} />
<link rel="alternate" hreflang="x-default" href={canonicalUrl} />

<meta name="theme-color" content={brand.themeColor.light} media="(prefers-color-scheme: light)" />
<meta name="theme-color" content={brand.themeColor.dark} media="(prefers-color-scheme: dark)" />
<meta name="application-name" content={brand.name} />
<meta name="apple-mobile-web-app-title" content={brand.name} />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="format-detection" content="telephone=no" />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={titleResult.text} />
<meta property="og:description" content={descResult.text} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content={brand.name} />
<meta property="og:locale" content={brand.locale} />
{pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
{modifiedDate && <meta property="article:modified_time" content={modifiedDate.toISOString()} />}
{author && <meta property="article:author" content={author} />}
{tags.map(tag => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={titleResult.text} />
<meta name="twitter:description" content={descResult.text} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={title} />

<link rel="icon" type="image/svg+xml" href={brand.favicon} />
<link rel="apple-touch-icon" href={brand.appleTouchIcon} />
<link rel="manifest" href={brand.manifest} />

<link rel="alternate" type="application/rss+xml" title={`${brand.name} RSS Feed`} href={`${siteUrl}/rss.xml`} />

<link rel="dns-prefetch" href="https://images.unsplash.com" />
<link rel="preconnect" href="https://images.unsplash.com" crossorigin />
<link rel="dns-prefetch" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

{jsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd, null, 0)} />
)}
