---
interface Props {
	name?: string;
	role?: string;
	bio?: string;
	avatar?: string;
	expertise?: string[];
	socials?: { href: string; label: string }[];
	publishDate?: string;
	lastUpdated?: string;
}

const {
	name = "AI Affiliate Factory",
	role = "Content Team",
	bio = "The AI Affiliate Factory team combines nutrition science, fitness research, and AI-powered content creation to deliver evidence-based health information to adults over 40.",
	avatar = "https://images.unsplash.com/photo-1633332755192-727a05c4013d?w=120&q=80&auto=format&fit=crop&fm=webp",
	expertise = ["Metabolic Health", "Healthy Aging", "Sleep Science"],
	socials = [],
	publishDate = "",
	lastUpdated = "",
} = Astro.props;
---

<aside
  class="mt-12 p-6 sm:p-8 bg-gradient-to-br from-gray-50 to-white dark:from-gray-800/40 dark:to-gray-800/20 rounded-2xl border border-gray-200 dark:border-gray-700"
  itemscope
  itemtype="https://schema.org/Person"
>
  <div class="flex flex-col sm:flex-row gap-5 items-center sm:items-start text-center sm:text-left">
    <img
      src={avatar}
      alt={name}
      width="80"
      height="80"
      loading="lazy"
      decoding="async"
      class="w-20 h-20 rounded-full object-cover shrink-0"
      itemprop="image"
    />
    <div class="flex-1 min-w-0">
      <p class="text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400 font-semibold mb-1">Written by</p>
      <p class="text-lg font-bold text-gray-900 dark:text-white" itemprop="name">{name}</p>
      <p class="text-sm text-gray-500 dark:text-gray-400" itemprop="jobTitle">{role}</p>
      <p class="mt-3 text-sm text-gray-600 dark:text-gray-300 leading-relaxed" itemprop="description">{bio}</p>

      {expertise.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5 justify-center sm:justify-start">
          {expertise.map((area) => (
            <span class="inline-block text-xs font-medium px-2.5 py-0.5 rounded-full bg-primary/10 text-primary">
              {area}
            </span>
          ))}
        </div>
      )}

      <meta itemprop="worksFor" content="Metabolic 40+" />
      {publishDate && <meta itemprop="datePublished" content={publishDate} />}
      {lastUpdated && <meta itemprop="dateModified" content={lastUpdated} />}

      {socials.length > 0 && (
        <div class="mt-4 flex gap-3 justify-center sm:justify-start">
          {socials.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-gray-500 dark:text-gray-400 hover:text-primary transition-colors"
            >
              {link.label}
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</aside>
