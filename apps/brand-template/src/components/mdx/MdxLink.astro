---
interface Props {
	href?: string;
}

const { href = "#" } = Astro.props;

const isExternal = href.startsWith("http") || href.startsWith("//");
const isMail = href.startsWith("mailto:") || href.startsWith("tel:");

// Affiliate detection: known affiliate networks and product domains
const affiliateDomains = [
	"javaburn.net",
	"clickbank.net",
	"hop.clickbank.net",
	"jvzproduct.com",
	"shareasale.com",
	"amazon.com",
];
const isAffiliate =
	isExternal &&
	affiliateDomains.some((domain) => href.toLowerCase().includes(domain));

const rel = isAffiliate
	? "noopener noreferrer nofollow sponsored"
	: isExternal
		? "noopener noreferrer"
		: undefined;

const target = isExternal ? "_blank" : undefined;
---

<a
  href={href}
  class="text-primary underline underline-offset-2 hover:text-primary-dark transition-colors decoration-primary/30 hover:decoration-primary/60"
  target={target}
  rel={rel}
>
  <slot />
  {isExternal && (
    <svg class="inline-block w-3.5 h-3.5 ml-0.5 -mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
    </svg>
  )}
  {isAffiliate && (
    <span class="sr-only">(affiliate link)</span>
  )}
</a>
