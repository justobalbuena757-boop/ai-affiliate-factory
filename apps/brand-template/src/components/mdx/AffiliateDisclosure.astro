---
interface Props {
	product?: string;
	network?: string;
}

const { product = "Java Burn", network = "official website" } = Astro.props;
---

<aside
  class="my-8 p-4 sm:p-5 bg-warning/5 dark:bg-warning/10 border border-warning/20 dark:border-warning/30 rounded-xl"
  role="note"
  aria-label="Affiliate disclosure"
>
  <div class="flex gap-3 items-start">
    <svg class="w-5 h-5 text-warning shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <div class="flex-1 min-w-0">
      <p class="text-sm font-semibold text-warning-dark dark:text-warning mb-1">Affiliate Disclosure</p>
      <p class="text-sm text-warning-dark dark:text-warning leading-relaxed">
        This article contains affiliate links to <strong>{product}</strong>. If you purchase through these links on the {network}, we may earn a commission <strong>at no extra cost to you</strong>. We only recommend products we've researched and believe provide genuine value to adults over 40. Our editorial content is not influenced by affiliate partnerships. <a href="/disclosure" class="underline hover:no-underline">Learn more</a>.
      </p>
    </div>
  </div>
</aside>
