---
interface Props {
	className?: string;
}

const { className } = Astro.props;
const isBlock = className?.startsWith("language-");
const lang = className?.replace("language-", "") || "";
---

{isBlock ? (
  <div class="relative group my-8">
    {lang && (
      <span class="absolute top-0 right-0 px-3 py-1 text-xs font-mono text-muted dark:text-muted-dark bg-muted/10 dark:bg-surface-dark rounded-bl-lg rounded-tr-xl border-l border-b border-border dark:border-border-dark">
        {lang}
      </span>
    )}
    <pre class="overflow-x-auto rounded-xl bg-bg-dark text-foreground-dark p-5 pt-8 text-sm leading-relaxed">
      <slot />
    </pre>
  </div>
) : (
  <code class="inline-block bg-muted/10 dark:bg-surface-dark text-primary-dark dark:text-primary-light font-mono text-sm px-1.5 py-0.5 rounded-md -my-0.5">
    <slot />
  </code>
)}
