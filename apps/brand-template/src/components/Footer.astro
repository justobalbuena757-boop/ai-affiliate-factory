---
import { Icon } from "astro-icon/components";
import tenant from "../config/tenant.json";
import type { CollectionEntry } from "astro:content";

interface FooterLink {
	label: string;
	href: string;
}

interface FooterColumn {
	title: string | null;
	links: FooterLink[];
}

interface Props {
	pillars?: CollectionEntry<"pillars">[];
}

const { pillars = [] } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-border dark:border-border-dark bg-muted/5 dark:bg-surface-dark/30">
  <div class="max-w-6xl mx-auto px-4 tablet:px-6 md:px-8 py-12">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <h3 class="text-sm font-bold text-foreground dark:text-foreground-dark uppercase tracking-wider mb-3">{tenant.brand.name}</h3>
        <p class="text-sm text-muted dark:text-muted-dark leading-relaxed">
          {tenant.brand.description}
        </p>
      </div>
      <div>
        <h3 class="text-sm font-bold text-foreground dark:text-foreground-dark uppercase tracking-wider mb-3">Content Pillars</h3>
        <ul class="space-y-2">
          {pillars.map((p) => (
            <li>
              <a
                href={`/${p.id.replace('.mdx', '')}`}
                class="flex items-center gap-1.5 text-sm text-muted dark:text-muted-dark hover:text-primary transition-colors"
              >
                <Icon name={p.id === 'coffee-wellness' ? 'lucide:coffee' : 'lucide:moon'} class="w-4 h-4 shrink-0" />
                {p.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
      {(tenant.footer?.columns as FooterColumn[] || []).map((col) => (
        <div>
          {col.title && (
            <h3 class="text-sm font-bold text-foreground dark:text-foreground-dark uppercase tracking-wider mb-3">{col.title}</h3>
          )}
          <ul class="space-y-2">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-muted dark:text-muted-dark hover:text-primary transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="mt-8 pt-8 border-t border-border dark:border-border-dark text-center">
      <p class="text-xs text-muted dark:text-muted-dark">
        &copy; {year} {tenant.footer?.copyright || tenant.brand.companyName}. All rights reserved.
      </p>
    </div>
  </div>
</footer>
