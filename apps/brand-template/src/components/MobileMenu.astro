---
import type { CollectionEntry } from "astro:content";
const { pillars = [] } = Astro.props as {
	pillars?: CollectionEntry<"pillars">[];
};
---

<button
  class="sm:hidden flex items-center justify-center min-w-[44px] min-h-[44px] rounded-lg text-muted dark:text-muted-dark hover:bg-muted/10 dark:hover:bg-surface-dark transition-colors"
  aria-label="Menu"
  onclick="document.getElementById('mobile-drawer').classList.remove('translate-x-full'); document.getElementById('mobile-overlay').classList.remove('hidden')"
>
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
  </svg>
</button>

<div id="mobile-overlay" class="fixed inset-0 z-40 bg-bg-dark/50 backdrop-blur-sm hidden" onclick="document.getElementById('mobile-drawer').classList.add('translate-x-full'); document.getElementById('mobile-overlay').classList.add('hidden')"></div>
<div id="mobile-drawer" class="fixed top-0 right-0 bottom-0 w-72 max-w-[85vw] bg-surface dark:bg-surface-dark shadow-xl z-50 p-6 overflow-y-auto transform translate-x-full transition-transform duration-300" style="padding-top:env(safe-area-inset-top,1rem)">
  <button class="absolute top-4 right-4 flex items-center justify-center min-w-[44px] min-h-[44px] text-muted hover:text-foreground dark:hover:text-foreground-dark" onclick="document.getElementById('mobile-drawer').classList.add('translate-x-full'); document.getElementById('mobile-overlay').classList.add('hidden')">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
  <nav class="mt-14 flex flex-col gap-1">
    {pillars.map((pillar) => {
      const iconName = pillar.id === 'coffee-wellness' ? 'lucide:coffee' : 'lucide:moon';
      return (
        <a
          href={`/${pillar.id.replace('.mdx', '')}`}
          class="flex items-center gap-3 min-h-[44px] px-3 rounded-lg text-base font-medium text-foreground dark:text-foreground-dark hover:text-primary hover:bg-muted/10 dark:hover:bg-surface-dark transition-colors"
          onclick="document.getElementById('mobile-drawer').classList.add('translate-x-full'); document.getElementById('mobile-overlay').classList.add('hidden')"
        >
          <svg class="w-5 h-5 shrink-0 text-muted" data-icon={iconName} aria-hidden="true">
            <use href={`#ai:${iconName}`} />
          </svg>
          {pillar.data.title}
        </a>
      );
    })}
  </nav>
</div>
