{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 60
    },
    "description": {
      "type": "string",
      "minLength": 110,
      "maxLength": 155
    },
    "summary": {
      "type": "string",
      "maxLength": 200
    },
    "pubDate": {
      "type": "string",
      "format": "date-time"
    },
    "dateModified": {
      "type": "string",
      "format": "date-time"
    },
    "authorId": {
      "type": "string"
    },
    "pillar": {
      "type": "string"
    },
    "cluster": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "minimum": 1,
      "maximum": 9
    },
    "stage": {
      "type": "string",
      "enum": [
        "tofu",
        "mofu",
        "bofu"
      ]
    },
    "author": {
      "default": {
        "name": "AI Affiliate Factory",
        "sameAs": []
      },
      "type": "object",
      "properties": {
        "name": {
          "default": "AI Affiliate Factory",
          "type": "string"
        },
        "sameAs": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ogImage": {
      "type": "string",
      "format": "uri"
    },
    "featuredImage": {
      "type": "string",
      "format": "uri"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "pubDate",
    "pillar",
    "cluster",
    "order",
    "stage"
  ]
}