{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 60
    },
    "description": {
      "type": "string",
      "minLength": 110,
      "maxLength": 155
    },
    "summary": {
      "type": "string",
      "maxLength": 200
    },
    "icon": {
      "type": "string"
    },
    "ogImage": {
      "type": "string",
      "format": "uri"
    },
    "dateModified": {
      "default": "2026-06-01T05:43:34.657Z",
      "type": "string",
      "format": "date-time"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description"
  ]
}