{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["apps/brand-template/src/*"],
			"design-system-base": ["packages/design-system-base/src/index.js"],
			"design-system-base/*": ["packages/design-system-base/src/*"],
			"design-tokens-base": ["packages/design-tokens-base/css/tokens.css"]
		}
	},
	"exclude": ["node_modules"]
}
