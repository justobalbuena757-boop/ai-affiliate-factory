---
import Layout from './Layout.astro';
import { Container, Text, Badge, ArticleCard } from '@af/ui';
import type { ArticleCardProps } from '@af/ui';

type PillarCta = {
  label: string;
  href: string;
};

export type PillarLayoutProps = {
  title: string;
  description: string;
  image?: string;
  icon?: string;
  category?: string;
  articles: ArticleCardProps[];
  cta?: PillarCta;
  headerLogoText?: string;
  headerLogoHref?: string;
  footerText?: string;
};

const {
  title,
  description,
  image,
  icon,
  category,
  articles,
  cta,
  headerLogoText,
  headerLogoHref,
  footerText,
} = Astro.props as PillarLayoutProps;
---

<Layout
  title={`${title} — Evergreen Vitality Labs`}
  description={description}
  image={image}
  headerLogoText={headerLogoText}
  headerLogoHref={headerLogoHref}
  footerText={footerText}
>
  <section class="py-[var(--space-14)] bg-[var(--color-surface-secondary)]">
    <Container size="default">
      <div class="max-w-[var(--layout-prose-max)]">
        {category && (
          <Badge variant="accent" size="md" class="mb-[var(--space-4)]">
            {category}
          </Badge>
        )}
        <Text as="h1" variant="display" weight="bold" class="mb-[var(--space-4)]">
          {icon && <span class="mr-[var(--space-2)]" aria-hidden="true">{icon}</span>}
          {title}
        </Text>
        <Text as="p" variant="body" color="secondary" class="text-[var(--text-title)] mb-[var(--space-6)]">
          {description}
        </Text>
        {cta && (
          <a
            href={cta.href}
            class="inline-flex items-center px-[var(--space-6)] py-[var(--space-3)] rounded-[var(--radius-md)] bg-[var(--color-cta-primary)] text-[var(--color-text-inverse)] font-medium text-[var(--text-body)] leading-[var(--leading-normal)] no-underline hover:bg-[var(--color-cta-primary-darker)] transition-colors duration-[var(--motion-duration-fast)]"
          >
            {cta.label}
          </a>
        )}
      </div>
    </Container>
  </section>

  <section class="py-[var(--space-12)]">
    <Container size="default">
      {articles.length > 0 && (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[var(--space-6)]">
          {articles.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>
      )}
      {articles.length === 0 && (
        <Text variant="body" color="muted" class="text-center">
          Articles coming soon.
        </Text>
      )}
    </Container>
  </section>

  {cta && (
    <section class="py-[var(--space-12)] bg-[var(--color-cta-primary-lighter)]">
      <Container size="narrow">
        <div class="text-center">
          <Text as="h2" variant="headline" weight="bold" class="mb-[var(--space-4)]">
            Ready to Start Your Journey?
          </Text>
          <Text variant="body" color="secondary" class="mb-[var(--space-6)]">
            Take our quiz to discover your metabolic health score and get personalized recommendations.
          </Text>
          <a
            href={cta.href}
            class="inline-flex items-center px-[var(--space-6)] py-[var(--space-3)] rounded-[var(--radius-md)] bg-[var(--color-cta-primary)] text-[var(--color-text-inverse)] font-medium text-[var(--text-body)] leading-[var(--leading-normal)] no-underline hover:bg-[var(--color-cta-primary-darker)] transition-colors duration-[var(--motion-duration-fast)]"
          >
            {cta.label}
          </a>
        </div>
      </Container>
    </section>
  )}
</Layout>
