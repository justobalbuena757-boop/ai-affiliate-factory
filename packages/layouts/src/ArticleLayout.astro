---
import Layout from './Layout.astro';
import { Container, Text, Badge, Breadcrumb, AuthorBio, AffiliateBadge, TableOfContents } from '@af/ui';
import type { BreadcrumbItem } from '@af/ui';
import type { TocSection } from '@af/ui';

export type ArticleMeta = {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  author?: {
    name: string;
    avatarUrl?: string;
    role?: string;
    bio?: string;
    href?: string;
  };
  publishedAt: string;
  updatedAt?: string;
  readTime?: string;
  category?: string;
  tags?: string[];
  tableOfContents?: TocSection[];
  breadcrumb?: BreadcrumbItem[];
};

export type ArticleLayoutProps = {
  article: ArticleMeta;
  headerLogoText?: string;
  headerLogoHref?: string;
  footerText?: string;
  sidebar?: boolean;
};

const {
  article,
  headerLogoText,
  headerLogoHref,
  footerText,
  sidebar = true,
} = Astro.props as ArticleLayoutProps;

const breadcrumbItems: BreadcrumbItem[] = article.breadcrumb || [
  { label: 'Home', href: '/' },
  ...(article.category ? [{ label: article.category, href: `/${article.category.toLowerCase().replace(/\s+/g, '-')}` }] : []),
  { label: article.title, href: '' },
];
---

<Layout
  title={`${article.title} — Evergreen Vitality Labs`}
  description={article.description}
  canonical={article.canonical}
  image={article.image}
  headerLogoText={headerLogoText}
  headerLogoHref={headerLogoHref}
  footerText={footerText}
>
  <article class="py-[var(--space-10)]">
    <Container size="default">
      <Breadcrumb items={breadcrumbItems} class="mb-[var(--space-8)]" />

      <div class={sidebar
        ? 'grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-[var(--space-10)]'
        : ''
      }>
        <div>
          <header class="mb-[var(--space-8)]">
            {article.category && (
              <Badge variant="accent" size="sm" class="mb-[var(--space-4)]">
                {article.category}
              </Badge>
            )}

            <Text as="h1" variant="display" weight="bold" class="mb-[var(--space-4)]">
              {article.title}
            </Text>

            <Text variant="body" color="secondary" class="mb-[var(--space-6)]">
              {article.description}
            </Text>

            <div class="flex items-center gap-[var(--space-4)] text-[var(--text-caption)] text-[var(--color-text-muted)]">
              <time datetime={article.publishedAt}>
                {new Date(article.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              {article.readTime && (
                <>
                  <span aria-hidden="true">·</span>
                  <span>{article.readTime} min read</span>
                </>
              )}
              {article.updatedAt && article.updatedAt !== article.publishedAt && (
                <>
                  <span aria-hidden="true">·</span>
                  <span>Updated <time datetime={article.updatedAt}>{new Date(article.updatedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time></span>
                </>
              )}
            </div>
          </header>

          {article.image && (
            <figure class="mb-[var(--space-8)] rounded-[var(--radius-lg)] overflow-hidden">
              <img src={article.image} alt={article.title} class="w-full aspect-[2/1] object-cover" loading="eager" />
            </figure>
          )}

          <div class="prose prose-custom max-w-none">
            <slot />
          </div>

          {article.tags && article.tags.length > 0 && (
            <div class="flex flex-wrap gap-[var(--space-2)] mt-[var(--space-8)] pt-[var(--space-6)] border-t border-[var(--color-border-subtle)]">
              {article.tags.map((tag) => (
                <Badge variant="default" size="sm">{tag}</Badge>
              ))}
            </div>
          )}

          <AffiliateBadge class="mt-[var(--space-8)]" />

          {article.author && (
            <div class="mt-[var(--space-8)] pt-[var(--space-6)] border-t border-[var(--color-border-subtle)]">
              <AuthorBio
                name={article.author.name}
                avatarUrl={article.author.avatarUrl}
                role={article.author.role}
                bio={article.author.bio || ''}
                href={article.author.href}
              />
            </div>
          )}
        </div>

        {sidebar && article.tableOfContents && article.tableOfContents.length > 0 && (
          <aside class="hidden lg:block">
            <div class="sticky top-[var(--space-6)]">
              <TableOfContents sections={article.tableOfContents} />
            </div>
          </aside>
        )}
      </div>
    </Container>
  </article>
</Layout>
