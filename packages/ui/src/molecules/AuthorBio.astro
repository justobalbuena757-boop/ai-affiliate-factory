---
export type AuthorBioProps = {
  name: string;
  avatarUrl?: string;
  role?: string;
  bio: string;
  href?: string;
  class?: string;
};

const {
  name,
  avatarUrl,
  role,
  bio,
  href,
  class: className,
} = Astro.props as AuthorBioProps;

const Tag = href ? 'a' : 'div';
const linkProps = href ? { href, class: 'group no-underline' } : {};

const classes = ['flex items-start gap-[var(--space-4)] p-[var(--space-4)] rounded-[var(--radius-md)]', className].filter(Boolean).join(' ');
---

<Tag {...linkProps} class={[classes, href ? 'hover:bg-[var(--color-surface-secondary)] transition-colors duration-[var(--motion-duration-fast)]' : ''].filter(Boolean).join(' ')}>
  {avatarUrl && (
    <img
      src={avatarUrl}
      alt={name}
      class="w-12 h-12 rounded-[var(--radius-full)] object-cover flex-shrink-0"
      loading="lazy"
    />
  )}
  <div>
    <p class="font-semibold text-[var(--color-text-primary)] text-[var(--text-body)] leading-[var(--leading-snug)]">{name}</p>
    {role && <p class="text-[var(--text-caption)] text-[var(--color-text-muted)] leading-[var(--leading-normal)]">{role}</p>}
    <p class="mt-[var(--space-2)] text-[var(--text-body)] text-[var(--color-text-secondary)] leading-[var(--leading-relaxed)]">{bio}</p>
  </div>
</Tag>
