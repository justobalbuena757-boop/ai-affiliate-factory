---
export type FeatureItem = {
  title: string;
  description: string;
  icon?: string;
};

export type FeaturesGridProps = {
  title?: string;
  features: FeatureItem[];
  columns?: 2 | 3 | 4;
  class?: string;
};

const {
  title,
  features,
  columns = 3,
  class: className,
} = Astro.props as FeaturesGridProps;

const gridCols: Record<number, string> = {
  2: 'grid-cols-1 sm:grid-cols-2',
  3: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3',
  4: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4',
};

const classes = ['grid gap-[var(--space-8)]', gridCols[columns], className].filter(Boolean).join(' ');
---

<div>
  {title && (
    <h2 class="text-center text-[var(--text-headline)] font-bold text-[var(--color-text-primary)] leading-[var(--leading-tight)] mb-[var(--space-10)]">
      {title}
    </h2>
  )}
  <div class={classes}>
    {features.map((feature) => (
      <div class="text-center">
        {feature.icon && (
          <div class="w-12 h-12 mx-auto mb-[var(--space-4)] rounded-[var(--radius-full)] bg-[var(--color-cta-primary-lighter)] flex items-center justify-center text-[var(--color-cta-primary)] text-[var(--text-title)]" aria-hidden="true">
            {feature.icon}
          </div>
        )}
        <h3 class="font-semibold text-[var(--color-text-primary)] text-[var(--text-title)] leading-[var(--leading-snug)] mb-[var(--space-2)]">{feature.title}</h3>
        <p class="text-[var(--text-body)] text-[var(--color-text-secondary)] leading-[var(--leading-relaxed)]">{feature.description}</p>
      </div>
    ))}
  </div>
</div>
