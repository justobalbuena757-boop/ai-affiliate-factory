---
type ProgressVariant = 'default' | 'success' | 'warning' | 'accent';
type ProgressSize = 'sm' | 'md' | 'lg';

export type ProgressBarProps = {
  value: number;
  variant?: ProgressVariant;
  size?: ProgressSize;
  label?: string;
  showValue?: boolean;
  class?: string;
};

const {
  value,
  variant = 'default' as ProgressVariant,
  size = 'md' as ProgressSize,
  label,
  showValue = false,
  class: className,
} = Astro.props as ProgressBarProps;

const clampedValue = Math.min(100, Math.max(0, value));

const variantMap: Record<ProgressVariant, string> = {
  default: 'bg-[var(--color-cta-primary)]',
  success: 'bg-[var(--color-cta-primary-darker)]',
  warning: 'bg-[var(--color-accent)]',
  accent: 'bg-[var(--color-cta-primary-light)]',
};

const sizeMap: Record<ProgressSize, string> = {
  sm: 'h-[var(--space-1)]',
  md: 'h-[var(--space-2)]',
  lg: 'h-[var(--space-3)]',
};

const trackClasses = ['w-full bg-[var(--color-surface-tertiary)] rounded-[var(--radius-full)] overflow-hidden', sizeMap[size], className].filter(Boolean).join(' ');

const fillClasses = ['h-full rounded-[var(--radius-full)] transition-all duration-[var(--motion-duration-normal)] ease-[var(--motion-easing-emphasized)]', variantMap[variant]].join(' ');
---

<div class={trackClasses} role="progressbar" aria-valuenow={clampedValue} aria-valuemin={0} aria-valuemax={100} aria-label={label || 'Progress'}>
  <div class={fillClasses} style={{ width: `${clampedValue}%` }} />
  {showValue && <span class="sr-only">{clampedValue}%</span>}
</div>
