{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"design-system-base#build": {
			"outputs": []
		},
		"design-tokens-base#build": {
			"outputs": []
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"check": {
			"dependsOn": ["^build"],
			"outputs": []
		}
	}
}
