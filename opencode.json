{
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
		"github": {
			"type": "local",
			"command": "npx",
			"args": ["-y", "@modelcontextprotocol/server-github"],
			"env": {
				"GITHUB_TOKEN": "${GITHUB_TOKEN}"
			},
			"enabled": true
		},
		"context7": {
			"type": "remote",
			"url": "https://mcp.context7.com/mcp",
			"headers": {
				"CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
			},
			"enabled": true
		},
		"Astro docs": {
			"type": "remote",
			"url": "https://mcp.docs.astro.build/mcp",
			"enabled": true
		}
	},
	"snapshot": false
}
